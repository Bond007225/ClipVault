<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="Workspace" referent="RBX0"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">true</bool><float name="Gravity">196.2</float></Properties></Item>
<Item class="Lighting" referent="RBX1"><Properties><string name="Name">Lighting</string><float name="ClockTime">17.5</float><bool name="GlobalShadows">true</bool></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX7"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX6"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">CarPhysics</string><ProtectedString name="Source"><![CDATA[--!strict
-- Raycast-suspension vehicle simulation.
-- Runs on whichever machine owns the car's physics: the driver's client for
-- player cars, the server for police units. Forces are applied as impulses to
-- the chassis each step; wheels are purely visual (massless, no collision).

local Players = game:GetService("Players")

local CarStats = require(script.Parent.CarStats)

local CarPhysics = {}
CarPhysics.__index = CarPhysics

export type Input = {
	throttle: number, -- -1..1 (negative = brake / reverse)
	steer: number, -- -1..1 (positive = right)
	handbrake: boolean,
	nitro: boolean,
}

export type Telemetry = {
	speed: number, -- signed forward speed, studs/s
	mph: number,
	rpm: number,
	redline: number,
	gear: string,
	nitro: number, -- 0..1
	grounded: boolean,
	drifting: boolean,
}

type Wheel = {
	name: string,
	attachment: Attachment,
	weld: Weld?,
	front: boolean,
	left: boolean,
	lastLength: number?,
	length: number,
	spin: number,
}

local WHEEL_NAMES = { "FL", "FR", "RL", "RR" }
local TAU = math.pi * 2

function CarPhysics.new(model: Model, stats: CarStats.Stats, animateWheels: boolean)
	local chassis = model:FindFirstChild("Chassis") :: BasePart
	assert(chassis, "car has no Chassis")
	local self = setmetatable({}, CarPhysics)
	self.model = model
	self.chassis = chassis
	self.animateWheels = animateWheels
	self.wheels = {} :: { Wheel }
	for _, name in WHEEL_NAMES do
		local att = chassis:FindFirstChild("Wheel" .. name) :: Attachment
		table.insert(self.wheels, {
			name = name,
			attachment = att,
			weld = chassis:FindFirstChild("Weld_" .. name) :: Weld?,
			front = string.sub(name, 1, 1) == "F",
			left = string.sub(name, 2, 2) == "L",
			lastLength = nil,
			length = 0,
			spin = 0,
		})
	end
	self.params = RaycastParams.new()
	self.params.FilterType = Enum.RaycastFilterType.Exclude
	self.params.IgnoreWater = true
	self.ignoreTimer = 0
	self.gear = 1
	self.reverse = false
	self.rpm = 900
	self.shiftTimer = 0
	self.steerAngle = 0
	self.manual = false
	self.flipTimer = 0
	self.grounded = 0
	self.drifting = false
	self.fuelEmpty = false
	self.tiresPopped = false
	self:setStats(stats)
	self.nitro = stats.NitroCapacity
	self:refreshIgnore()
	return self
end

function CarPhysics.setStats(self: any, stats: CarStats.Stats)
	self.stats = stats
	self.gear = math.clamp(self.gear, 1, #stats.Gears)
	if self.nitro then
		self.nitro = math.min(self.nitro, stats.NitroCapacity)
	end
end

function CarPhysics.refreshIgnore(self: any)
	local list: { Instance } = { self.model }
	for _, plr in Players:GetPlayers() do
		if plr.Character then
			table.insert(list, plr.Character)
		end
	end
	self.params.FilterDescendantsInstances = list
end

function CarPhysics.shift(self: any, dir: number)
	local stats = self.stats
	local newGear = math.clamp(self.gear + dir, 1, #stats.Gears)
	if newGear ~= self.gear then
		self.gear = newGear
		self.shiftTimer = stats.ShiftTime
	end
end

function CarPhysics.step(self: any, dt: number, input: Input): Telemetry
	dt = math.min(dt, 1 / 20)
	local stats: CarStats.Stats = self.stats
	local chassis: BasePart = self.chassis
	if chassis.Anchored then
		return self:_telemetry(0)
	end

	self.ignoreTimer -= dt
	if self.ignoreTimer <= 0 then
		self.ignoreTimer = 1
		self:refreshIgnore()
	end

	local cf = chassis.CFrame
	local up = cf.UpVector
	local look = cf.LookVector
	local mass = chassis.AssemblyMass
	local vel = chassis.AssemblyLinearVelocity
	local fwdSpeed = vel:Dot(look)
	local speed = vel.Magnitude
	local g = workspace.Gravity
	local com = chassis.AssemblyCenterOfMass

	local throttleIn = math.clamp(input.throttle, -1, 1)
	if self.fuelEmpty and throttleIn > 0 then
		throttleIn = 0
	end

	-- Steering: less lock at speed
	local speedRatio = math.clamp(math.abs(fwdSpeed) / stats.TopSpeed, 0, 1)
	local steerLimit = math.rad(stats.SteerAngle) * (1 - speedRatio * 0.72)
	local targetSteer = -math.clamp(input.steer, -1, 1) * steerLimit
	self.steerAngle += (targetSteer - self.steerAngle) * math.min(1, dt * 10)

	-- Pedals: forward/reverse/brake resolution
	local drive = 0
	local braking = 0
	if throttleIn > 0.05 then
		if fwdSpeed < -3 then
			braking = throttleIn
		else
			self.reverse = false
			drive = throttleIn
		end
	elseif throttleIn < -0.05 then
		if fwdSpeed > 3 and not self.reverse then
			braking = -throttleIn
		else
			self.reverse = true
			drive = throttleIn
		end
	end

	-- Engine & gearbox
	local gears = stats.Gears
	local rpmPerSps = stats.Redline / (stats.TopSpeed * gears[#gears])
	local ratio = gears[self.gear]
	local wheelRpm = math.abs(fwdSpeed) * rpmPerSps * (self.reverse and gears[1] or ratio)
	local targetRpm = math.max(stats.IdleRpm, wheelRpm)
	if self.grounded == 0 or self.shiftTimer > 0 then
		targetRpm = stats.IdleRpm + math.abs(throttleIn) * (stats.Redline - stats.IdleRpm) * 0.9
	elseif drive > 0 and self.gear == 1 then
		-- clutch slip on launch
		targetRpm = math.max(targetRpm, stats.IdleRpm + (stats.Redline * 0.55 - stats.IdleRpm) * drive)
	end
	self.rpm += (targetRpm - self.rpm) * math.min(1, dt * 12)

	if self.shiftTimer > 0 then
		self.shiftTimer -= dt
	elseif not self.manual and not self.reverse and self.grounded > 0 then
		if self.rpm >= stats.Redline * 0.95 and self.gear < #gears and drive > 0 then
			self:shift(1)
		elseif self.gear > 1 then
			local lowerRpm = wheelRpm * gears[self.gear - 1] / ratio
			if lowerRpm < stats.Redline * 0.78 and self.rpm < stats.Redline * 0.5 then
				self:shift(-1)
			end
		end
	end

	local accel = 0
	if self.shiftTimer <= 0 then
		if drive > 0 then
			if wheelRpm < stats.Redline then
				accel = stats.Power * CarStats.torqueCurve(self.rpm / stats.Redline) * (ratio / gears[1]) * drive
			end
		elseif drive < 0 then
			if fwdSpeed > -stats.ReverseSpeed then
				accel = stats.Power * 0.45 * drive
			end
		end
	end

	-- Nitrous
	local usingNitro = false
	if input.nitro and drive > 0 and self.nitro > 0 and stats.NitroCapacity > 0 then
		usingNitro = true
		self.nitro = math.max(0, self.nitro - dt)
		accel = accel * stats.NitroBoost + stats.Power * 0.12
	elseif stats.NitroCapacity > 0 then
		self.nitro = math.min(stats.NitroCapacity, self.nitro + dt * stats.NitroCapacity / 45)
	end
	self.usingNitro = usingNitro

	accel *= stats.WeightFactor
	if self.tiresPopped then
		accel *= 0.6
	end

	-- Suspension
	local quarterMass = mass / 4
	local omega = TAU * stats.SpringFreq
	local k = quarterMass * omega * omega
	local c = 2 * stats.Damping * math.sqrt(k * quarterMass)
	local restLen = g / (omega * omega) + stats.RideHeight
	local radius = stats.WheelRadius
	local grip = stats.Grip * (self.tiresPopped and 0.45 or 1)
	local driven = stats.Drivetrain
	local nDriven = driven == "AWD" and 4 or 2
	local grounded = 0
	local drifting = false
	local stopped = math.abs(throttleIn) < 0.05 and speed < 2.5

	for _, w in self.wheels do
		local mount = cf:PointToWorldSpace(w.attachment.Position)
		local result = workspace:Raycast(mount, -up * (restLen + radius), self.params)
		if result then
			grounded += 1
			local length = math.max(0, result.Distance - radius)
			local compression = restLen - length
			local compVel = if w.lastLength then (w.lastLength - length) / dt else 0
			w.lastLength = length
			w.length = length
			local springForce = math.max(0, k * compression + c * compVel)
			if length < 0.15 then
				springForce += k * (0.15 - length) * 4 -- bump stop
			end
			chassis:ApplyImpulseAtPosition(up * springForce * dt, mount)

			-- Tyre forces on the ground plane
			local normal = result.Normal
			local wheelLook = if w.front then (cf * CFrame.Angles(0, self.steerAngle, 0)).LookVector else look
			local fwd = wheelLook - normal * wheelLook:Dot(normal)
			if fwd.Magnitude > 1e-3 then
				fwd = fwd.Unit
				local side = fwd:Cross(normal)
				local pv = chassis:GetVelocityAtPosition(result.Position)
				local vLong = pv:Dot(fwd)
				local vLat = pv:Dot(side)
				local isRear = not w.front
				local maxF = grip * springForce
				if input.handbrake and isRear then
					maxF *= 0.35
				end

				local latF = math.clamp(-vLat * quarterMass / dt * 0.6, -maxF, maxF)
				local longF = 0
				local isDriven = driven == "AWD" or (driven == "FWD" and w.front) or (driven == "RWD" and isRear)
				if isDriven then
					longF += accel * mass / nDriven
				end
				if braking > 0 then
					local b = stats.Brake * quarterMass * braking * (if w.front then 1.15 else 0.85)
					longF -= math.sign(vLong) * math.min(b, math.abs(vLong) * quarterMass / dt)
				end
				if input.handbrake and isRear then
					longF -= math.sign(vLong) * math.min(stats.Brake * quarterMass * 0.8, math.abs(vLong) * quarterMass / dt)
				end
				if stopped then
					longF -= vLong * quarterMass / dt * 0.5
				else
					longF -= vLong * quarterMass * 0.01 -- rolling resistance
				end

				-- friction circle
				local total = math.sqrt(latF * latF + longF * longF)
				if total > maxF * 1.1 and total > 0 then
					local scale = maxF * 1.1 / total
					latF *= scale
					longF *= scale
				end
				if isRear and math.abs(vLat) > 12 then
					drifting = true
				end

				-- Apply at centre-of-mass height to keep the car from rolling over
				local offset = result.Position - com
				offset -= up * offset:Dot(up)
				chassis:ApplyImpulseAtPosition((fwd * longF + side * latF) * dt, com + offset)
				w.spin -= vLong / radius * dt
			end
		else
			w.lastLength = nil
			w.length = restLen
		end

		if self.animateWheels and w.weld then
			local steer = if w.front then self.steerAngle else 0
			local camber = math.rad(stats.Camber) * (if w.left then 1 else -1)
			w.weld.C0 = CFrame.new(w.attachment.Position - Vector3.new(0, w.length, 0))
				* CFrame.Angles(0, steer, 0)
				* CFrame.Angles(0, 0, camber)
				* CFrame.Angles(w.spin, 0, 0)
		end
	end
	self.grounded = grounded
	self.drifting = drifting

	-- Aero: drag and downforce
	if speed > 0.5 then
		chassis:ApplyImpulse(-vel * speed * stats.DragK * mass * dt)
		if grounded > 0 then
			chassis:ApplyImpulse(-up * mass * speed * speed * stats.Downforce * dt)
		end
	end

	-- Air: damp pitch/roll so jumps land wheels-down
	if grounded == 0 then
		local av = chassis.AssemblyAngularVelocity
		local yaw = up * av:Dot(up)
		chassis:ApplyAngularImpulse(-(av - yaw) * mass * 12 * dt)
	end

	-- Flip recovery
	if up.Y < 0.3 and speed < 12 then
		self.flipTimer += dt
		if self.flipTimer > 2.5 then
			self.flipTimer = 0
			self:reset()
		end
	else
		self.flipTimer = 0
	end

	return self:_telemetry(fwdSpeed)
end

function CarPhysics.reset(self: any)
	local chassis: BasePart = self.chassis
	local look = chassis.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(0, 0, -1)
	end
	local pos = chassis.Position + Vector3.new(0, 5, 0)
	chassis.AssemblyLinearVelocity = Vector3.zero
	chassis.AssemblyAngularVelocity = Vector3.zero
	chassis.CFrame = CFrame.lookAt(pos, pos + flat.Unit)
end

function CarPhysics._telemetry(self: any, fwdSpeed: number): Telemetry
	local stats = self.stats
	local gear = if self.reverse then "R" elseif math.abs(fwdSpeed) < 0.5 and self.rpm < 1000 then "N" else tostring(self.gear)
	return {
		speed = fwdSpeed,
		mph = math.abs(fwdSpeed) * 0.626,
		rpm = self.rpm,
		redline = stats.Redline,
		gear = gear,
		nitro = if stats.NitroCapacity > 0 then self.nitro / stats.NitroCapacity else 0,
		grounded = self.grounded > 0,
		drifting = self.drifting,
	}
end

return CarPhysics
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">CarStats</string><ProtectedString name="Source"><![CDATA[--!strict
-- Pure stat computation: base car + upgrades + tuning -> physics stats.
-- The server's result is authoritative (it is written onto the car model);
-- the client runs the same code to preview numbers in the garage.

local Config = require(script.Parent.Config)

local CarStats = {}

export type CarData = {
	Upgrades: { [string]: number },
	Cosmetics: { [string]: string },
	Tuning: { [string]: number },
}

export type Stats = {
	Power: number,
	TopSpeedMph: number,
	TopSpeed: number,
	Redline: number,
	IdleRpm: number,
	Gears: { number },
	ShiftTime: number,
	Grip: number,
	Brake: number,
	SpringFreq: number,
	Damping: number,
	RideHeight: number,
	WheelRadius: number,
	Drivetrain: string,
	NitroCapacity: number,
	NitroBoost: number,
	FuelCapacity: number,
	Economy: number,
	WeightFactor: number,
	SteerAngle: number,
	Downforce: number,
	DragK: number,
	ReverseSpeed: number,
	Camber: number,
	Rating: number,
	Class: string,
}

-- Normalised torque curve, peak 1.0 at ~67% of redline
function CarStats.torqueCurve(t: number): number
	t = math.clamp(t, 0, 1.05)
	return (0.6 + 0.8 * t - 0.6 * t * t) / 0.8667
end

function CarStats.defaultData(carId: string): CarData
	local def = Config.Cars[carId]
	local upgrades = {}
	for _, cat in Config.UpgradeOrder do
		upgrades[cat] = 1
	end
	local tuning = {}
	for key, t in Config.Tuning do
		tuning[key] = t.Default
	end
	return {
		Upgrades = upgrades,
		Cosmetics = {
			Paint = def and def.DefaultPaint or "Arctic White",
			Finish = "Gloss",
			Rims = "Silver",
			Underglow = "Off",
			Spoiler = "None",
			Tint = "Light",
		},
		Tuning = tuning,
	}
end

local function classFor(rating: number): string
	if rating >= 900 then
		return "S"
	elseif rating >= 750 then
		return "A"
	elseif rating >= 600 then
		return "B"
	elseif rating >= 450 then
		return "C"
	end
	return "D"
end

function CarStats.finalize(s: any): Stats
	s.TopSpeed = s.TopSpeedMph / Config.STUDS_TO_MPH
	local gears = s.Gears
	-- Drag tuned so drive force at redline in top gear balances drag at TopSpeed
	local topAccel = s.Power * s.WeightFactor * CarStats.torqueCurve(1) * (gears[#gears] / gears[1])
	s.DragK = topAccel / (s.TopSpeed * s.TopSpeed)
	local rating = s.Power * s.WeightFactor * 6
		+ s.TopSpeedMph * 1.6
		+ s.Grip * 140
		+ s.Brake * 0.6
		+ (0.4 - s.ShiftTime) * 200
		+ s.NitroCapacity * s.NitroBoost * 8
	s.Rating = math.floor(rating)
	s.Class = classFor(s.Rating)
	return s :: Stats
end

function CarStats.compute(carId: string, data: CarData?): Stats
	local base = Config.Cars[carId]
	assert(base, "unknown car " .. tostring(carId))
	local upgrades = data and data.Upgrades or {}
	local tuning = data and data.Tuning or {}

	local s: { [string]: any } = {
		Power = base.Power,
		TopSpeedMph = base.TopSpeed,
		Redline = base.Redline,
		IdleRpm = 900,
		Gears = table.clone(base.Gears),
		ShiftTime = 0.35,
		Grip = base.Grip,
		Brake = base.Brake,
		SpringFreq = base.SpringFreq,
		Damping = base.Damping,
		RideHeight = base.RideHeight,
		WheelRadius = base.WheelRadius,
		Drivetrain = base.Drivetrain,
		NitroCapacity = 0,
		NitroBoost = 1,
		FuelCapacity = base.FuelCapacity,
		Economy = 1,
		WeightFactor = 1,
		SteerAngle = 34,
		Downforce = 0.0003,
		ReverseSpeed = 40,
		Camber = 0,
	}

	for cat, def in Config.Upgrades do
		local tier = math.clamp(math.floor(tonumber(upgrades[cat]) or 1), 1, #def.Tiers)
		local t = def.Tiers[tier]
		if t.Mul then
			for k, v in t.Mul do
				s[k] *= v
			end
		end
		if t.Add then
			for k, v in t.Add do
				s[k] += v
			end
		end
		if t.Set then
			for k, v in t.Set do
				s[k] = v
			end
		end
	end

	local function tune(key: string): number
		local spec = Config.Tuning[key]
		return math.clamp(tonumber(tuning[key]) or spec.Default, spec.Min, spec.Max)
	end
	s.RideHeight = math.max(0.25, s.RideHeight + tune("RideHeight"))
	s.SpringFreq *= tune("Stiffness")
	local gearing = tune("Gearing")
	s.Power *= 1 + 0.1 * gearing
	s.TopSpeedMph *= 1 - 0.06 * gearing
	s.Camber = tune("Camber")

	return CarStats.finalize(s)
end

-- Build stats directly from a police unit spec (no upgrades)
function CarStats.fromUnit(unit: { [string]: any }, heatScale: number): Stats
	local geo = Config.Cars[unit.Geometry]
	local s: { [string]: any } = {
		Power = unit.Power * heatScale,
		TopSpeedMph = unit.TopSpeed * math.sqrt(heatScale),
		Redline = 7000,
		IdleRpm = 900,
		Gears = { 3.4, 2.2, 1.6, 1.2, 0.95, 0.78 },
		ShiftTime = 0.15,
		Grip = unit.Grip,
		Brake = unit.Brake,
		SpringFreq = 2.0,
		Damping = 0.55,
		RideHeight = geo.RideHeight,
		WheelRadius = geo.WheelRadius,
		Drivetrain = unit.Drivetrain,
		NitroCapacity = 0,
		NitroBoost = 1,
		FuelCapacity = 20,
		Economy = 1,
		WeightFactor = 1,
		SteerAngle = 36,
		Downforce = 0.0004,
		ReverseSpeed = 40,
		Camber = 0,
	}
	return CarStats.finalize(s)
end

return CarStats
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- All gameplay tunables in one place. The client can read this file, so every
-- price/limit here is re-checked on the server before it is trusted.

local Config = {}

-- 1 stud = 0.28 m (Roblox convention) -> mph
Config.STUDS_TO_MPH = 0.626
Config.MILE_STUDS = 5748

Config.StartingCash = 15000
Config.CashPerMileDriven = 20
Config.GasPricePerGallon = 3.5

-- Speed limits in mph per zone ("Track" is unlimited)
Config.SpeedLimits = {
	City = 45,
	Rural = 55,
	Highway = 70,
	Track = math.huge,
}

----------------------------------------------------------------------
-- Map layout
----------------------------------------------------------------------
Config.Map = {
	CityBlocks = 10, -- 10x10 grid of city blocks
	CellSize = 280, -- road-centre to road-centre
	RoadWidth = 52,
	SidewalkWidth = 8,
	RingHalfSize = 1750, -- highway ring around the city (centreline)
	HighwayWidth = 96,
	InterstateLength = 7200, -- long straight highway out to the tracks
	QuarterMile = 1437, -- studs
	HalfMile = 2874,
}

----------------------------------------------------------------------
-- Cars
--  Power      : drive acceleration (studs/s^2) in 1st gear at peak torque
--  TopSpeed   : mph at redline in top gear
--  Brake      : braking deceleration (studs/s^2)
--  Grip       : tyre friction coefficient
----------------------------------------------------------------------
export type CarDef = {
	Name: string,
	Price: number,
	Style: string,
	Drivetrain: string,
	Width: number,
	Length: number,
	BodyHeight: number,
	CabinHeight: number,
	WheelBase: number,
	WheelRadius: number,
	Power: number,
	TopSpeed: number,
	Redline: number,
	Gears: { number },
	Grip: number,
	Brake: number,
	SpringFreq: number,
	Damping: number,
	RideHeight: number,
	FuelCapacity: number,
	Weight: number,
	DefaultPaint: string,
	Seats: number,
}

Config.Cars = {
	Hatch = {
		Name = "Kanto Hatch",
		Price = 0,
		Style = "hatch",
		Drivetrain = "FWD",
		Width = 6.2,
		Length = 12.5,
		BodyHeight = 2.2,
		CabinHeight = 2.2,
		WheelBase = 8.4,
		WheelRadius = 1.15,
		Power = 34,
		TopSpeed = 118,
		Redline = 7200,
		Gears = { 3.3, 2.1, 1.5, 1.15, 0.92 },
		Grip = 1.05,
		Brake = 110,
		SpringFreq = 1.8,
		Damping = 0.45,
		RideHeight = 0.9,
		FuelCapacity = 11,
		Weight = 2600,
		DefaultPaint = "Arctic White",
		Seats = 4,
	},
	Coupe = {
		Name = "Shiro S-Coupe",
		Price = 18000,
		Style = "coupe",
		Drivetrain = "RWD",
		Width = 6.5,
		Length = 14,
		BodyHeight = 2.0,
		CabinHeight = 2.0,
		WheelBase = 9.4,
		WheelRadius = 1.2,
		Power = 42,
		TopSpeed = 145,
		Redline = 7800,
		Gears = { 3.6, 2.3, 1.65, 1.25, 1.0, 0.82 },
		Grip = 1.1,
		Brake = 125,
		SpringFreq = 2.0,
		Damping = 0.5,
		RideHeight = 0.8,
		FuelCapacity = 13,
		Weight = 2800,
		DefaultPaint = "Midnight Purple",
		Seats = 2,
	},
	Pickup = {
		Name = "Ridge 1500 Pickup",
