<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!strict
-- Single list of every remote. The server creates them at startup; the client
-- waits for them. Add a remote = add one line here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	-- client -> server
	"SpawnCar", -- ()
	"BuyCar", -- (carId)
	"SelectCar", -- (carId)
	"BuyUpgrade", -- (category, tier)
	"SetCosmetic", -- (key, optionName)
	"SetTuning", -- (key, value)
	"ExitCar", -- ()
	-- server -> client
	"ProfileUpdated", -- (profileSnapshot)
	"Notify", -- (text, kind)
	"OpenGarage", -- ()
	"RaceUpdate", -- (payload)
	"CameraFlash", -- ()
}

local FUNCTIONS = {
	"GetProfile", -- () -> profileSnapshot
}

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		local r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
	end
	for _, name in FUNCTIONS do
		local r = Instance.new("RemoteFunction")
		r.Name = name
		r.Parent = folder
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Remotes.event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.func(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX20"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX19"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[--!strict
-- THE server entry point. Two-phase startup: every system's init() runs
-- (in dependency order) before any system's start() is spawned.

local Systems = script:WaitForChild("Systems")

local ORDER = {
	"PlayerData",
	"MapBuilder", -- must build before anything queries the layout
	"CarService",
	"Traffic",
	"Police",
	"Racing",
	"Meets",
	"World",
}

local loaded: { { name: string, mod: any } } = {}
for _, name in ORDER do
	local mod = require(Systems:WaitForChild(name) :: ModuleScript) :: any
	table.insert(loaded, { name = name, mod = mod })
end

for _, entry in loaded do
	if typeof(entry.mod.init) == "function" then
		local ok, err = pcall(entry.mod.init)
		if not ok then
			warn("[Server] init failed for " .. entry.name .. ": " .. tostring(err))
		end
	end
end

for _, entry in loaded do
	if typeof(entry.mod.start) == "function" then
		task.spawn(entry.mod.start)
	end
end

print("[MidnightMotors] server started")
]]></ProtectedString></Properties><Item class="Folder" referent="RBX18"><Properties><string name="Name">Systems</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">CarFactory</string><ProtectedString name="Source"><![CDATA[--!strict
-- Builds car models out of parts (no external assets needed). One invisible
-- "Chassis" box carries all the physics; every visual part is massless,
-- non-colliding and welded to it. Wheels use Welds so the driver's client can
-- animate suspension travel, steering and spin by changing C0.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local CarFactory = {}

export type BuildOptions = {
	Kind: string, -- "Player" | "Traffic" | "Police"
	Cosmetics: { [string]: string }?,
	RideHeight: number,
	WheelRadius: number,
	Suv: boolean?,
	Name: string?,
}

local DARK = Color3.fromRGB(25, 25, 28)
local TRIM = Color3.fromRGB(40, 40, 44)

local function findOption(list: { any }, name: string?): any
	for _, opt in list do
		if opt.Name == name then
			return opt
		end
	end
	return list[1]
end

local function addPart(model: Model, chassis: BasePart, size: Vector3, localCf: CFrame, color: Color3, material: Enum.Material?, cls: string?): BasePart
	local p = Instance.new((cls or "Part") :: any) :: BasePart
	p.Size = size
	p.CFrame = chassis.CFrame * localCf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	local w = Instance.new("WeldConstraint")
	w.Part0 = chassis
	w.Part1 = p
	w.Parent = p
	p.Parent = model
	return p
end

local function paint(p: BasePart)
	p:SetAttribute("Paint", true)
end

----------------------------------------------------------------------
-- Spoilers can be swapped on a live car, so they are built separately
----------------------------------------------------------------------
local function buildSpoiler(model: Model, chassis: BasePart, kind: string)
	for _, child in model:GetChildren() do
		if child:GetAttribute("Spoiler") then
			child:Destroy()
		end
	end
	local W = model:GetAttribute("W") :: number
	local L = model:GetAttribute("L") :: number
	local top = model:GetAttribute("DeckTop") :: number
	local color = model:GetAttribute("PaintColor") :: Color3? or Color3.new(1, 1, 1)
	local parts: { BasePart } = {}
	local z = L / 2 - 0.9
	if kind == "Ducktail" then
		table.insert(parts, addPart(model, chassis, Vector3.new(W - 0.6, 0.35, 1.4), CFrame.new(0, top + 0.25, z) * CFrame.Angles(math.rad(-12), 0, 0), color))
	elseif kind == "Wing" then
		for _, x in { -W / 3, W / 3 } do
			table.insert(parts, addPart(model, chassis, Vector3.new(0.3, 1.2, 0.6), CFrame.new(x, top + 0.6, z), TRIM))
		end
		table.insert(parts, addPart(model, chassis, Vector3.new(W - 0.4, 0.25, 1.6), CFrame.new(0, top + 1.25, z) * CFrame.Angles(math.rad(-8), 0, 0), color))
	elseif kind == "GT Wing" then
		for _, x in { -W / 4, W / 4 } do
			table.insert(parts, addPart(model, chassis, Vector3.new(0.3, 2.2, 0.8), CFrame.new(x, top + 1.1, z + 0.3), TRIM))
		end
		table.insert(parts, addPart(model, chassis, Vector3.new(W + 0.6, 0.25, 2), CFrame.new(0, top + 2.3, z + 0.4) * CFrame.Angles(math.rad(-10), 0, 0), DARK, Enum.Material.Fabric))
		for _, x in { -(W / 2 + 0.35), W / 2 + 0.35 } do
			table.insert(parts, addPart(model, chassis, Vector3.new(0.15, 1, 2.4), CFrame.new(x, top + 2.2, z + 0.4), DARK))
		end
	end
	for _, p in parts do
		p:SetAttribute("Spoiler", true)
		if p.Color == color then
			paint(p)
		end
	end
end

----------------------------------------------------------------------
-- Cosmetics
----------------------------------------------------------------------
function CarFactory.applyCosmetics(model: Model, cosmetics: { [string]: string })
	local chassis = model:FindFirstChild("Chassis") :: BasePart
	local paintOpt = findOption(Config.Paints, cosmetics.Paint)
	local finish = findOption(Config.Finishes, cosmetics.Finish)
	local rims = findOption(Config.RimColors, cosmetics.Rims)
	local tint = findOption(Config.Tints, cosmetics.Tint)
	local glow = findOption(Config.Underglows, cosmetics.Underglow)
	model:SetAttribute("PaintColor", paintOpt.Color)

	if (model:GetAttribute("Spoiler") or "None") ~= cosmetics.Spoiler and model:GetAttribute("Kind") == "Player" then
		buildSpoiler(model, chassis, cosmetics.Spoiler or "None")
		model:SetAttribute("Spoiler", cosmetics.Spoiler or "None")
	end

	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d:GetAttribute("Paint") then
				d.Color = paintOpt.Color
				d.Material = finish.Material
				d.Reflectance = finish.Reflectance
			elseif d:GetAttribute("Rim") then
				d.Color = rims.Color
			elseif d:GetAttribute("Glass") then
				d.Transparency = tint.Transparency
			elseif d.Name == "Underglow" then
				local light = d:FindFirstChildOfClass("PointLight")
				if glow.Color then
					d.Transparency = 0.2
					d.Color = glow.Color
					if light then
						light.Enabled = true
						light.Color = glow.Color
					end
				else
					d.Transparency = 1
					if light then
						light.Enabled = false
					end
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Build
----------------------------------------------------------------------
function CarFactory.restHeight(rideHeight: number, wheelRadius: number): number
	return rideHeight + wheelRadius
end

function CarFactory.build(geometryId: string, opts: BuildOptions): Model
	local def = Config.Cars[geometryId]
	assert(def, "unknown geometry " .. geometryId)
	local W, L, BH, CH = def.Width, def.Length, def.BodyHeight, def.CabinHeight
	local WB, R = def.WheelBase, opts.WheelRadius
	local style = if opts.Suv then "suv" else def.Style

	local model = Instance.new("Model")
	model.Name = opts.Name or def.Name
	model:SetAttribute("Kind", opts.Kind)
	model:SetAttribute("Geometry", geometryId)
	model:SetAttribute("W", W)
	model:SetAttribute("L", L)

	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = Vector3.new(W - 0.4, 1.4, L - 0.6)
	chassis.CFrame = CFrame.new()
	chassis.Transparency = 1
	chassis.CanCollide = true
	chassis.CustomPhysicalProperties = PhysicalProperties.new(2, 0.1, 0, 10, 1)
	chassis.Parent = model
	model.PrimaryPart = chassis

	local yB = -0.5 -- body bottom
	local yT = yB + BH -- deck top
	model:SetAttribute("DeckTop", yT)

	-- cabin layout per style
	local cabinL, cabinZ, fastback = L * 0.45, 0, false
	if style == "hatch" then
		cabinL, cabinZ = L * 0.55, L * 0.12
	elseif style == "coupe" then
		cabinL, cabinZ, fastback = L * 0.38, L * 0.04, true
	elseif style == "sedan" then
		cabinL, cabinZ = L * 0.42, L * 0.02
	elseif style == "muscle" then
		cabinL, cabinZ, fastback = L * 0.34, L * 0.08, true
	elseif style == "truck" then
		cabinL, cabinZ = L * 0.26, -L * 0.1
	elseif style == "suv" then
		cabinL, cabinZ = L * 0.6, L * 0.12
	elseif style == "super" then
		cabinL, cabinZ, fastback = L * 0.32, L * 0.0, true
	end
	local paintColor = Color3.new(1, 1, 1)

	-- lower body
	if style == "truck" then
		local bedTop = yT + 0.8
		paint(addPart(model, chassis, Vector3.new(W, BH, L * 0.5), CFrame.new(0, yB + BH / 2, -L * 0.25), paintColor))
		paint(addPart(model, chassis, Vector3.new(W, BH * 0.6, L * 0.5), CFrame.new(0, yB + BH * 0.3, L * 0.25), paintColor))
		for _, x in { -W / 2 + 0.2, W / 2 - 0.2 } do
			paint(addPart(model, chassis, Vector3.new(0.4, bedTop - (yB + BH * 0.6) + 0.6, L * 0.5), CFrame.new(x, (bedTop + yB + BH * 0.6) / 2, L * 0.25), paintColor))
		end
		paint(addPart(model, chassis, Vector3.new(W, bedTop - (yB + BH * 0.6) + 0.6, 0.4), CFrame.new(0, (bedTop + yB + BH * 0.6) / 2, L / 2 - 0.2), paintColor))
		model:SetAttribute("DeckTop", bedTop)
	else
		paint(addPart(model, chassis, Vector3.new(W, BH, L), CFrame.new(0, yB + BH / 2, 0), paintColor))
		-- hood bulge
		paint(addPart(model, chassis, Vector3.new(W - 1.6, 0.3, L * 0.25), CFrame.new(0, yT + 0.15, -L * 0.3), paintColor))
	end
	if style == "muscle" then
		addPart(model, chassis, Vector3.new(1.6, 0.6, 2.2), CFrame.new(0, yT + 0.5, -L * 0.28), DARK)
	elseif style == "super" then
		for _, x in { -W / 2 - 0.02, W / 2 + 0.02 } do
			addPart(model, chassis, Vector3.new(0.1, BH * 0.5, 2.4), CFrame.new(x, yB + BH * 0.55, L * 0.12), DARK)
		end
	end

	-- cabin: glass box + roof + sloped windshield
	local glass = addPart(model, chassis, Vector3.new(W - 0.7, CH, cabinL), CFrame.new(0, yT + CH / 2, cabinZ), Color3.fromRGB(20, 25, 35), Enum.Material.Glass)
	glass:SetAttribute("Glass", true)
	paint(addPart(model, chassis, Vector3.new(W - 0.6, 0.3, cabinL - 0.4), CFrame.new(0, yT + CH + 0.15, cabinZ), paintColor))
	local shield = addPart(model, chassis, Vector3.new(W - 0.7, CH, CH * 0.9), CFrame.new(0, yT + CH / 2, cabinZ - cabinL / 2 - CH * 0.45), Color3.fromRGB(20, 25, 35), Enum.Material.Glass, "WedgePart")
	shield:SetAttribute("Glass", true)
	if fastback then
		local rear = addPart(model, chassis, Vector3.new(W - 0.7, CH, CH * 1.6), CFrame.new(0, yT + CH / 2, cabinZ + cabinL / 2 + CH * 0.8) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(20, 25, 35), Enum.Material.Glass, "WedgePart")
		rear:SetAttribute("Glass", true)
	end
	-- pillars
	for _, x in { -(W / 2 - 0.4), W / 2 - 0.4 } do
		paint(addPart(model, chassis, Vector3.new(0.25, CH, 0.4), CFrame.new(x, yT + CH / 2, cabinZ - cabinL / 2 + 0.2), paintColor))
		paint(addPart(model, chassis, Vector3.new(0.25, CH, 0.4), CFrame.new(x, yT + CH / 2, cabinZ + cabinL / 2 - 0.2), paintColor))
	end

	-- bumpers, lights, mirrors, plate
	addPart(model, chassis, Vector3.new(W + 0.1, 0.9, 0.6), CFrame.new(0, yB + 0.45, -L / 2 - 0.2), TRIM)
	addPart(model, chassis, Vector3.new(W + 0.1, 0.9, 0.6), CFrame.new(0, yB + 0.45, L / 2 + 0.2), TRIM)
	for _, x in { -(W / 2 - 1), W / 2 - 1 } do
		local head = addPart(model, chassis, Vector3.new(1.4, 0.5, 0.2), CFrame.new(x, yT - 0.45, -L / 2 - 0.05), Color3.fromRGB(255, 250, 230), Enum.Material.Neon)
		local spot = Instance.new("SpotLight")
		spot.Name = "Headlight"
		spot.Face = Enum.NormalId.Front
		spot.Range = 70
		spot.Angle = 70
		spot.Brightness = 3
		spot.Enabled = false
		spot.Parent = head
		CollectionService:AddTag(spot, "CarLight")
		local tail = addPart(model, chassis, Vector3.new(1.4, 0.5, 0.2), CFrame.new(x, yT - 0.45, L / 2 + 0.05), Color3.fromRGB(200, 0, 0), Enum.Material.Neon)
		tail.Name = "Taillight"
		paint(addPart(model, chassis, Vector3.new(0.6, 0.4, 0.3), CFrame.new(if x < 0 then -W / 2 - 0.2 else W / 2 + 0.2, yT + 0.4, cabinZ - cabinL / 2 + 0.4), paintColor))
	end
	addPart(model, chassis, Vector3.new(2, 0.6, 0.05), CFrame.new(0, yB + 1.2, L / 2 + 0.03), Color3.fromRGB(240, 240, 240))

	-- underglow
	local glow = addPart(model, chassis, Vector3.new(W - 1.2, 0.1, L - 2), CFrame.new(0, yB - 0.05, 0), Color3.new(0, 0, 0), Enum.Material.Neon)
	glow.Name = "Underglow"
	glow.Transparency = 1
	local glowLight = Instance.new("PointLight")
	glowLight.Range = 14
	glowLight.Brightness = 3
	glowLight.Enabled = false
	glowLight.Parent = glow

	-- wheels
	local rest = opts.RideHeight
	for _, name in { "FL", "FR", "RL", "RR" } do
		local front = string.sub(name, 1, 1) == "F"
		local left = string.sub(name, 2, 2) == "L"
		local pos = Vector3.new((if left then -1 else 1) * (W / 2 - 0.55), 0, (if front then -1 else 1) * WB / 2)
		local att = Instance.new("Attachment")
		att.Name = "Wheel" .. name
		att.Position = pos
		att.Parent = chassis

		local tire = Instance.new("Part")
		tire.Name = "Tire" .. name
		tire.Shape = Enum.PartType.Cylinder
		tire.Size = Vector3.new(1.1, R * 2, R * 2)
		tire.Color = Color3.fromRGB(22, 22, 22)
		tire.Material = Enum.Material.Rubber
		tire.CanCollide = false
		tire.CanQuery = false
		tire.CanTouch = false
		tire.Massless = true
		local c0 = CFrame.new(pos - Vector3.new(0, rest, 0))
		tire.CFrame = chassis.CFrame * c0
		tire.Parent = model
		local weld = Instance.new("Weld")
		weld.Name = "Weld_" .. name
		weld.Part0 = chassis
		weld.Part1 = tire
		weld.C0 = c0
		weld.Parent = chassis

		local rim = Instance.new("Part")
		rim.Name = "Rim"
		rim.Shape = Enum.PartType.Cylinder
		rim.Size = Vector3.new(1.16, R * 1.3, R * 1.3)
		rim.Material = Enum.Material.Metal
		rim.CanCollide = false
		rim.CanQuery = false
		rim.CanTouch = false
		rim.Massless = true
		rim.CFrame = tire.CFrame
		rim:SetAttribute("Rim", true)
		rim.Parent = model
		local rw = Instance.new("WeldConstraint")
		rw.Part0 = tire
		rw.Part1 = rim
		rw.Parent = rim
		-- hub cap
		local hub = Instance.new("Part")
		hub.Name = "Hub"
		hub.Shape = Enum.PartType.Cylinder
		hub.Size = Vector3.new(1.2, R * 0.4, R * 0.4)
		hub.Color = TRIM
		hub.CanCollide = false
		hub.CanQuery = false
		hub.CanTouch = false
		hub.Massless = true
		hub.CFrame = tire.CFrame
		hub.Parent = model
		local hw = Instance.new("WeldConstraint")
		hw.Part0 = tire
		hw.Part1 = hub
		hw.Parent = hub
	end

	-- seats
	if opts.Kind ~= "Traffic" then
		local seatY = yT - 1.3
		local frontZ = if def.Seats > 2 then cabinZ - cabinL * 0.15 else cabinZ
		local function seat(cls: string, name: string, x: number, z: number): Seat | VehicleSeat
			local s = Instance.new(cls :: any) :: any
			s.Name = name
			s.Size = Vector3.new(1.8, 0.4, 1.8)
			s.CFrame = chassis.CFrame * CFrame.new(x, seatY, z)
			s.Transparency = 1
			s.CanCollide = false
			s.CanTouch = false -- only enter via prompts
			s.Massless = true
			s.Parent = model
			local w = Instance.new("WeldConstraint")
			w.Part0 = chassis
			w.Part1 = s
			w.Parent = s
			return s
		end
		local driver = seat("VehicleSeat", "DriverSeat", -W / 4, frontZ) :: VehicleSeat
		driver.MaxSpeed = 0
		driver.Torque = 0
		driver.TurnSpeed = 0
		driver.HeadsUpDisplay = false
		if opts.Kind == "Player" then
			seat("Seat", "PassengerSeat", W / 4, frontZ)
			if def.Seats > 2 and style ~= "truck" then
				seat("Seat", "RearSeatL", -W / 4, cabinZ + cabinL * 0.3)
				seat("Seat", "RearSeatR", W / 4, cabinZ + cabinL * 0.3)
			end
			for _, side in { -1, 1 } do
				local att = Instance.new("Attachment")
				att.Name = if side < 0 then "DriverDoor" else "PassengerDoor"
				att.Position = Vector3.new(side * (W / 2 + 0.5), 0.5, frontZ)
				att.Parent = chassis
				local pp = Instance.new("ProximityPrompt")
				pp.Name = if side < 0 then "DrivePrompt" else "RidePrompt"
				pp.ActionText = if side < 0 then "Drive" else "Ride"
				pp.ObjectText = def.Name
				pp.KeyboardKeyCode = if side < 0 then Enum.KeyCode.E else Enum.KeyCode.R
				pp.GamepadKeyCode = if side < 0 then Enum.KeyCode.ButtonY else Enum.KeyCode.ButtonX
				pp.HoldDuration = 0
				pp.MaxActivationDistance = 10
				pp.RequiresLineOfSight = false
				pp.Parent = att
			end
		end
	end

	-- police livery & lightbar
	if opts.Kind == "Police" then
		for _, side in { -1, 1 } do
			local door = addPart(model, chassis, Vector3.new(0.1, BH * 0.7, L * 0.38), CFrame.new(side * (W / 2 + 0.03), yB + BH * 0.5, cabinZ), Color3.fromRGB(240, 240, 240))
			local gui = Instance.new("SurfaceGui")
			gui.Face = if side < 0 then Enum.NormalId.Left else Enum.NormalId.Right
			gui.Parent = door
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Text = "POLICE"
			label.TextScaled = true
			label.Font = Enum.Font.GothamBlack
			label.TextColor3 = Color3.fromRGB(20, 40, 120)
			label.Parent = gui
		end
		local barY = yT + CH + 0.55
		addPart(model, chassis, Vector3.new(W - 1.6, 0.3, 1.2), CFrame.new(0, barY - 0.25, cabinZ), DARK)
		for _, side in { -1, 1 } do
			local color = if side < 0 then Color3.fromRGB(255, 20, 20) else Color3.fromRGB(20, 60, 255)
			local light = addPart(model, chassis, Vector3.new((W - 1.8) / 2, 0.4, 1), CFrame.new(side * (W - 1.8) / 4, barY, cabinZ), color, Enum.Material.Neon)
			light:SetAttribute("LightColor", color)
			light.Name = "Lightbar"
			local pl = Instance.new("PointLight")
			pl.Color = color
			pl.Range = 30
			pl.Brightness = 4
			pl.Enabled = false
			pl.Parent = light
			CollectionService:AddTag(light, "Lightbar")
		end
		-- push bar
		addPart(model, chassis, Vector3.new(W - 1, 1.4, 0.4), CFrame.new(0, yB + 0.9, -L / 2 - 0.6), DARK)
	end

	model:SetAttribute("RestHeight", CarFactory.restHeight(opts.RideHeight, R))
	model:SetAttribute("Spoiler", "None")
	local cosmetics = opts.Cosmetics
		or { Paint = def.DefaultPaint, Finish = "Gloss", Rims = "Silver", Underglow = "Off", Spoiler = "None", Tint = "Light" }
	if opts.Kind == "Police" then
		cosmetics = { Paint = "Jet Black", Finish = "Gloss", Rims = "Black", Underglow = "Off", Spoiler = "None", Tint = "Dark" }
	end
	CarFactory.applyCosmetics(model, cosmetics)
	return model
end

-- Place a built car so it rests on the ground at `cf` (cf = ground point + facing)
function CarFactory.place(model: Model, cf: CFrame)
	local h = model:GetAttribute("RestHeight") :: number
	model:PivotTo(cf * CFrame.new(0, h, 0))
end

return CarFactory
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">CarService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Player cars: buying, spawning, entering/exiting, upgrades & cosmetics,
-- fuel, gas pumps and garage terminals. All purchases are validated here.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CarStats = require(Shared.CarStats)
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)
local MapBuilder = require(script.Parent.MapBuilder)
local CarFactory = require(script.Parent.CarFactory)

local CarService = {}

local GARAGE_RANGE = 140
local SPAWN_COOLDOWN = 5

local vehiclesFolder: Folder
local playerCarsFolder: Folder
local cars: { [Player]: Model } = {}
local lastSpawn: { [Player]: number } = {}
local lastRemote: { [Player]: { [string]: number } } = {}
local mileage: { [Player]: { last: Vector3?, acc: number } } = {}

local function notify(player: Player, text: string, kind: string?)
	Remotes.event("Notify"):FireClient(player, text, kind or "info")
end

-- Simple per-player, per-remote rate limit
local function allow(player: Player, name: string, interval: number): boolean
	local t = os.clock()
	local map = lastRemote[player]
	if not map then
		map = {}
		lastRemote[player] = map
	end
	if map[name] and t - map[name] < interval then
		return false
	end
	map[name] = t
	return true
end

local function humanoidOf(player: Player): Humanoid?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then
		return hum
	end
	return nil
end

local function rootOf(player: Player): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function CarService.getCar(player: Player): Model?
	local car = cars[player]
	if car and car.Parent then
		return car
	end
	return nil
end

-- The car the player is currently driving (their own, in the driver seat)
function CarService.getDrivenCar(player: Player): Model?
	local car = CarService.getCar(player)
	if car and car:GetAttribute("Driver") == player.UserId then
		return car
	end
	return nil
end

function CarService.isNearGarage(player: Player): boolean
	local root = rootOf(player)
	if not root then
		return false
	end
	for _, g in MapBuilder.Layout.Garages do
		if (g.Terminal.Position - root.Position).Magnitude < GARAGE_RANGE then
			return true
		end
	end
	return false
end

local function resetWheels(car: Model, rideHeight: number)
	local chassis = car:FindFirstChild("Chassis") :: BasePart
	for _, name in { "FL", "FR", "RL", "RR" } do
		local weld = chassis:FindFirstChild("Weld_" .. name) :: Weld?
		local att = chassis:FindFirstChild("Wheel" .. name) :: Attachment?
		if weld and att then
			weld.C0 = CFrame.new(att.Position - Vector3.new(0, rideHeight, 0))
		end
	end
end

-- Settle a car that nobody is driving: snap it upright onto the ground and anchor
local function park(car: Model)
	local chassis = car:FindFirstChild("Chassis") :: BasePart?
	if not chassis or chassis.Anchored then
		return
	end
	local t = 0
	while t < 4 and chassis.AssemblyLinearVelocity.Magnitude > 2 do
		t += task.wait(0.25)
		if car:GetAttribute("Driver") then
			return
		end
	end
	if car:GetAttribute("Driver") or not car.Parent then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { vehiclesFolder }
	local hit = workspace:Raycast(chassis.Position + Vector3.new(0, 4, 0), Vector3.new(0, -60, 0), params)
	local groundY = if hit then hit.Position.Y else chassis.Position.Y - (car:GetAttribute("RestHeight") :: number)
	local look = chassis.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(0, 0, -1)
	end
	local pos = Vector3.new(chassis.Position.X, groundY, chassis.Position.Z)
	pcall(function()
		chassis:SetNetworkOwner(nil)
	end)
	chassis.Anchored = true
	CarFactory.place(car, CFrame.lookAt(pos, pos + flat.Unit))
	local stats = HttpService:JSONDecode(car:GetAttribute("Stats") :: string)
	resetWheels(car, stats.RideHeight)
end

function CarService.despawn(player: Player)
	local car = cars[player]
	if car then
		for _, d in car:GetDescendants() do
			if d:IsA("Seat") or d:IsA("VehicleSeat") then
				local occ = d.Occupant
				if occ then
					occ.Sit = false
				end
			end
		end
		car:Destroy()
		cars[player] = nil
	end
end

local function exitSeat(humanoid: Humanoid)
	local seat = humanoid.SeatPart
	if not seat then
		return
	end
	local car = seat.Parent :: Model
	local chassis = car and car:FindFirstChild("Chassis") :: BasePart?
	local weld = seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
	humanoid.Sit = false
	local char = humanoid.Parent :: Model
	if chassis and char then
		local localX = chassis.CFrame:PointToObjectSpace(seat.Position).X
		local side = if localX < 0 then -1 else 1
		local W = (car:GetAttribute("W") :: number?) or 6
		local cf = chassis.CFrame * CFrame.new(side * (W / 2 + 3), 1.5, 0)
		local up = Vector3.new(cf.Position.X, cf.Position.Y + 2, cf.Position.Z)
		task.defer(function()
			char:PivotTo(CFrame.lookAt(up, up + Vector3.new(chassis.CFrame.LookVector.X, 0, chassis.CFrame.LookVector.Z)))
		end)
	end
end
CarService.exitSeat = exitSeat

local function connectCar(player: Player, car: Model)
	local chassis = car:FindFirstChild("Chassis") :: BasePart
	local driverSeat = car:FindFirstChild("DriverSeat") :: VehicleSeat
	local drivePrompt = (chassis:FindFirstChild("DriverDoor") :: Attachment):FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
	local ridePrompt = (chassis:FindFirstChild("PassengerDoor") :: Attachment):FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt

	drivePrompt.Triggered:Connect(function(who: Player)
		local hum = humanoidOf(who)
		if not hum or hum.SeatPart then
			return
		end
		if who ~= player then
			notify(who, "This is " .. player.DisplayName .. "'s car.", "warn")
			return
		end
		if driverSeat.Occupant then
			return
		end
		driverSeat:Sit(hum)
	end)

	ridePrompt.Triggered:Connect(function(who: Player)
		local hum = humanoidOf(who)
		if not hum or hum.SeatPart then
			return
		end
		for _, child in car:GetChildren() do
			if child:IsA("Seat") and not child.Occupant then
				child:Sit(hum)
				return
			end
		end
		notify(who, "No free seats.", "warn")
	end)

	driverSeat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occ = driverSeat.Occupant
		if occ then
			local who = Players:GetPlayerFromCharacter(occ.Parent)
			if who ~= player then
				exitSeat(occ)
				return
			end
			chassis.Anchored = false
			car:SetAttribute("Driver", player.UserId)
			drivePrompt.Enabled = false
			local ok, err = pcall(function()
				chassis:SetNetworkOwner(player)
			end)
			if not ok then
				warn("[CarService] SetNetworkOwner failed:", err)
			end
			mileage[player] = { last = chassis.Position, acc = (mileage[player] and mileage[player].acc) or 0 }
		else
			car:SetAttribute("Driver", nil)
			drivePrompt.Enabled = true
			task.spawn(park, car)
		end
	end)
end

function CarService.spawnCar(player: Player, at: CFrame?): Model?
	local profile = PlayerData.get(player)
	if not profile then
		return nil
	end
	local carId = profile.Selected
	local data = profile.Cars[carId]
	if not data then
		return nil
	end
	CarService.despawn(player)

	local stats = CarStats.compute(carId, data)
	local car = CarFactory.build(carId, {
		Kind = "Player",
		Cosmetics = data.Cosmetics,
		RideHeight = stats.RideHeight,
		WheelRadius = stats.WheelRadius,
		Name = player.Name .. "_Car",
	})
	car:SetAttribute("Owner", player.UserId)
	car:SetAttribute("OwnerName", player.DisplayName)
	car:SetAttribute("CarId", carId)
	car:SetAttribute("Stats", HttpService:JSONEncode(stats))
	car:SetAttribute("FuelCapacity", stats.FuelCapacity)
	car:SetAttribute("Fuel", stats.FuelCapacity)
	car:SetAttribute("Economy", stats.Economy)
	local chassis = car:FindFirstChild("Chassis") :: BasePart
	chassis.Anchored = true

	-- choose a spawn point: given CFrame, else the free pad at the nearest garage
	local target = at
	if not target then
		local root = rootOf(player)
		local here = if root then root.Position else MapBuilder.Layout.Spawn.Position
		local bestGarage, bestD = nil, math.huge
		for _, g in MapBuilder.Layout.Garages do
			local d = (g.Terminal.Position - here).Magnitude
			if d < bestD then
				bestGarage, bestD = g, d
			end
		end
		if bestGarage then
			for _, pad in bestGarage.Pads do
				local free = true
				for _, other in playerCarsFolder:GetChildren() do
					if other:IsA("Model") and (other:GetPivot().Position - pad.Position).Magnitude < 12 then
						free = false
					end
				end
				if free then
					target = pad
					break
				end
			end
			target = target or bestGarage.Pads[1]
		end
	end
	CarFactory.place(car, target or MapBuilder.Layout.Spawn)
	car.Parent = playerCarsFolder
	cars[player] = car
	connectCar(player, car)
	return car
end

local function refreshCar(player: Player)
	local car = CarService.getCar(player)
	local profile = PlayerData.get(player)
	if not car or not profile then
		return
	end
	local carId = car:GetAttribute("CarId") :: string
	local data = profile.Cars[carId]
	if not data then
		return
	end
	local stats = CarStats.compute(carId, data)
	car:SetAttribute("Stats", HttpService:JSONEncode(stats))
	car:SetAttribute("FuelCapacity", stats.FuelCapacity)
	car:SetAttribute("Economy", stats.Economy)
	car:SetAttribute("Fuel", math.min(car:GetAttribute("Fuel") :: number, stats.FuelCapacity))
	CarFactory.applyCosmetics(car, data.Cosmetics)
	local chassis = car:FindFirstChild("Chassis") :: BasePart
	if chassis.Anchored then
		resetWheels(car, stats.RideHeight)
		local rest = CarFactory.restHeight(stats.RideHeight, stats.WheelRadius)
		local oldRest = car:GetAttribute("RestHeight") :: number
		car:SetAttribute("RestHeight", rest)
		car:PivotTo(car:GetPivot() * CFrame.new(0, rest - oldRest, 0))
	else
		car:SetAttribute("RestHeight", CarFactory.restHeight(stats.RideHeight, stats.WheelRadius))
	end
end

----------------------------------------------------------------------
-- Remote handlers
----------------------------------------------------------------------
local function onSpawnCar(player: Player)
	if not allow(player, "SpawnCar", 1) then
		return
	end
	if (player:GetAttribute("Heat") :: number? or 0) > 0 then
		notify(player, "You can't call your car while the police are after you!", "warn")
		return
	end
	local now = os.clock()
	if lastSpawn[player] and now - lastSpawn[player] < SPAWN_COOLDOWN then
		notify(player, "Wait a moment before spawning again.", "warn")
		return
	end
	local hum = humanoidOf(player)
	if hum and hum.SeatPart then
		exitSeat(hum)
	end
	lastSpawn[player] = now
	if CarService.spawnCar(player) then
		notify(player, "Your car is waiting at the nearest garage.", "info")
	end
end

local function onBuyCar(player: Player, carId: unknown)
	if not allow(player, "BuyCar", 0.5) or typeof(carId) ~= "string" then
		return
	end
	local def = Config.Cars[carId]
	local profile = PlayerData.get(player)
	if not def or not profile then
		return
	end
	if profile.Cars[carId] then
		notify(player, "You already own this car.", "warn")
		return
	end
	if not CarService.isNearGarage(player) then
		notify(player, "Visit a garage to buy cars.", "warn")
		return
	end
	if not PlayerData.trySpend(player, def.Price) then
		notify(player, "Not enough cash.", "warn")
		return
	end
	profile.Cars[carId] = CarStats.defaultData(carId)
	profile.Selected = carId
	PlayerData.changed(player)
	notify(player, "Purchased " .. def.Name .. "!", "money")
	CarService.spawnCar(player)
end

local function onSelectCar(player: Player, carId: unknown)
	if not allow(player, "SelectCar", 1) or typeof(carId) ~= "string" then
		return
	end
	local profile = PlayerData.get(player)
	if not profile or not profile.Cars[carId] then
		return
	end
	if not CarService.isNearGarage(player) then
		notify(player, "Visit a garage to switch cars.", "warn")
		return
	end
	profile.Selected = carId
	PlayerData.changed(player)
	CarService.spawnCar(player)
end

local function currentData(player: Player): (CarStats.CarData?, string?)
	local profile = PlayerData.get(player)
	if not profile then
		return nil, nil
	end
	return profile.Cars[profile.Selected], profile.Selected
end

local function onBuyUpgrade(player: Player, category: unknown, tier: unknown)
	if not allow(player, "BuyUpgrade", 0.3) or typeof(category) ~= "string" or typeof(tier) ~= "number" then
		return
	end
	local def = Config.Upgrades[category]
	local data = currentData(player)
	if not def or not data then
		return
	end
	if tier ~= tier or tier % 1 ~= 0 or tier < 1 or tier > #def.Tiers then
		return
	end
	if not CarService.isNearGarage(player) then
		notify(player, "Upgrades can only be installed at a garage.", "warn")
		return
	end
	local current = data.Upgrades[category] or 1
	if tier <= current then
		-- downgrading to an earlier part is free (parts are kept)
		data.Upgrades[category] = tier
	elseif tier == current + 1 then
		local price = def.Tiers[tier].Price
		if not PlayerData.trySpend(player, price) then
			notify(player, "Not enough cash.", "warn")
			return
		end
		data.Upgrades[category] = tier
		notify(player, string.format("Installed %s %s", def.Tiers[tier].Name, def.Name), "money")
	else
		notify(player, "Install the previous tier first.", "warn")
		return
	end
	PlayerData.changed(player)
	refreshCar(player)
end

local COSMETIC_LISTS: { [string]: { any } } = {
	Paint = Config.Paints,
	Finish = Config.Finishes,
	Rims = Config.RimColors,
	Underglow = Config.Underglows,
	Tint = Config.Tints,
}

local function optionExists(key: string, value: string): boolean
	if key == "Spoiler" then
		return table.find(Config.Spoilers, value) ~= nil
	end
	local list = COSMETIC_LISTS[key]
	if not list then
		return false
	end
	for _, opt in list do
		if opt.Name == value then
			return true
		end
	end
	return false
end

local function onSetCosmetic(player: Player, key: unknown, value: unknown)
	if not allow(player, "SetCosmetic", 0.3) or typeof(key) ~= "string" or typeof(value) ~= "string" then
		return
	end
	local price = Config.CosmeticPrices[key]
	local data = currentData(player)
	if not price or not data or not optionExists(key, value) then
		return
	end
	if data.Cosmetics[key] == value then
		return
	end
	if not CarService.isNearGarage(player) then
		notify(player, "Visit a garage to customise your car.", "warn")
		return
	end
	if not PlayerData.trySpend(player, price) then
		notify(player, "Not enough cash.", "warn")
		return
	end
	data.Cosmetics[key] = value
	PlayerData.changed(player)
	refreshCar(player)
end

local function onSetTuning(player: Player, key: unknown, value: unknown)
	if not allow(player, "SetTuning", 0.1) or typeof(key) ~= "string" or typeof(value) ~= "number" then
		return
	end
	local spec = Config.Tuning[key]
	local data = currentData(player)
	if not spec or not data or value ~= value then
		return
	end
	if not CarService.isNearGarage(player) then
		return
	end
	local snapped = math.clamp(math.round(value / spec.Step) * spec.Step, spec.Min, spec.Max)
	data.Tuning[key] = snapped
	PlayerData.changed(player)
	refreshCar(player)
end

local function onExitCar(player: Player)
	if not allow(player, "ExitCar", 0.3) then
		return
	end
	local hum = humanoidOf(player)
	if hum and hum.SeatPart then
		exitSeat(hum)
	end
end

----------------------------------------------------------------------
-- Fuel, mileage pay, pumps, garage terminals
----------------------------------------------------------------------
local function onRefuel(player: Player, pump: BasePart)
	local car = CarService.getCar(player)
	if not car then
		notify(player, "You don't have a car out.", "warn")
		return
	end
	if (car:GetPivot().Position - pump.Position).Magnitude > 45 then
		notify(player, "Bring your car closer to the pump.", "warn")
		return
	end
	local cap = car:GetAttribute("FuelCapacity") :: number
	local fuel = car:GetAttribute("Fuel") :: number
	local need = cap - fuel
	if need < 0.1 then
		notify(player, "Tank is already full.", "info")
		return
	end
	local profile = PlayerData.get(player)
	if not profile then
		return
	end
	local affordable = math.min(need, profile.Cash / Config.GasPricePerGallon)
	local cost = math.ceil(affordable * Config.GasPricePerGallon)
	if affordable < 0.1 or not PlayerData.trySpend(player, cost) then
		notify(player, "Not enough cash for gas.", "warn")
		return
	end
	car:SetAttribute("Fuel", fuel + affordable)
	notify(player, string.format("Filled %.1f gal for $%d", affordable, cost), "money")
end

function CarService.init()
	vehiclesFolder = workspace:FindFirstChild("Vehicles") :: Folder
	if not vehiclesFolder then
		vehiclesFolder = Instance.new("Folder")
		vehiclesFolder.Name = "Vehicles"
		vehiclesFolder.Parent = workspace
	end
	playerCarsFolder = Instance.new("Folder")
	playerCarsFolder.Name = "Players"
	playerCarsFolder.Parent = vehiclesFolder

	Remotes.event("SpawnCar").OnServerEvent:Connect(onSpawnCar)
	Remotes.event("BuyCar").OnServerEvent:Connect(onBuyCar)
	Remotes.event("SelectCar").OnServerEvent:Connect(onSelectCar)
	Remotes.event("BuyUpgrade").OnServerEvent:Connect(onBuyUpgrade)
	Remotes.event("SetCosmetic").OnServerEvent:Connect(onSetCosmetic)
	Remotes.event("SetTuning").OnServerEvent:Connect(onSetTuning)
	Remotes.event("ExitCar").OnServerEvent:Connect(onExitCar)

	for _, pump in MapBuilder.Layout.GasPumps do
		local pp = pump:FindFirstChildOfClass("ProximityPrompt")
		if pp then
			pp.Triggered:Connect(function(player)
				onRefuel(player, pump)
			end)
		end
	end
	for _, g in MapBuilder.Layout.Garages do
		local pp = g.Terminal:FindFirstChildOfClass("ProximityPrompt")
		if pp then
			pp.Triggered:Connect(function(player)
				Remotes.event("OpenGarage"):FireClient(player)
			end)
		end
	end
end

function CarService.start()
	local function onAdded(player: Player)
		if PlayerData.waitFor(player) then
			if not player.Character then
				player.CharacterAdded:Wait()
			end
			task.wait(1)
			if player.Parent and not cars[player] then
				CarService.spawnCar(player)
			end
		end
	end
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onAdded, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		CarService.despawn(player)
		lastSpawn[player] = nil
		lastRemote[player] = nil
		mileage[player] = nil
	end)

	RunService.Heartbeat:Connect(function(dt)
		for player, car in cars do
			if not car.Parent or car:GetAttribute("Driver") ~= player.UserId then
				continue
			end
			local chassis = car:FindFirstChild("Chassis") :: BasePart?
			if not chassis then
				continue
			end
			local speed = chassis.AssemblyLinearVelocity.Magnitude
			local fuel = car:GetAttribute("Fuel") :: number
			if fuel > 0 then
				local economy = (car:GetAttribute("Economy") :: number?) or 1
				local drain = (0.004 + speed * 0.00012) * economy * dt
				car:SetAttribute("Fuel", math.max(0, fuel - drain))
			end

			local m = mileage[player]
			if m and m.last then
				local d = (chassis.Position - m.last).Magnitude
				m.last = chassis.Position
				if d < 20 then -- ignore teleports
					m.acc += d
					if m.acc >= Config.MILE_STUDS then
						m.acc -= Config.MILE_STUDS
						PlayerData.addCash(player, Config.CashPerMileDriven, "Mile driven")
						local p = PlayerData.get(player)
						if p then
							p.Stats.Miles = (p.Stats.Miles or 0) + 1
						end
					end
				end
			end
		end
	end)
end

return CarService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Lanes</string><ProtectedString name="Source"><![CDATA[--!strict
-- Polyline lanes used by traffic, patrols and police spawning.

local Lanes = {}

export type Lane = {
	Name: string,
	Kind: string, -- "Highway" | "Interstate" | "City"
	Points: { Vector3 },
	Cum: { number },
	Length: number,
	Speed: number, -- studs/s cruising speed
}

local all: { Lane } = {}

function Lanes.add(name: string, kind: string, points: { Vector3 }, speed: number): Lane
	local pts = table.clone(points)
	table.insert(pts, points[1]) -- lanes are closed loops
	local cum = { 0 }
	local total = 0
	for i = 2, #pts do
		total += (pts[i] - pts[i - 1]).Magnitude
		cum[i] = total
	end
	local lane: Lane = { Name = name, Kind = kind, Points = pts, Cum = cum, Length = total, Speed = speed }
	table.insert(all, lane)
	return lane
end

function Lanes.all(): { Lane }
	return all
end

-- Position and direction at distance s along the lane
function Lanes.sample(lane: Lane, s: number): (Vector3, Vector3)
	s = s % lane.Length
	local cum = lane.Cum
	local lo, hi = 1, #cum
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if cum[mid] <= s then
			lo = mid
		else
			hi = mid
		end
	end
	local a, b = lane.Points[lo], lane.Points[lo + 1]
	local segLen = cum[lo + 1] - cum[lo]
	local t = if segLen > 0 then (s - cum[lo]) / segLen else 0
	return a:Lerp(b, t), (b - a).Unit
end

-- Closest point on a lane: returns s and planar distance
function Lanes.closest(lane: Lane, pos: Vector3): (number, number)
	local flat = Vector3.new(pos.X, 0, pos.Z)
	local bestS, bestD = 0, math.huge
	for i = 1, #lane.Points - 1 do
		local a = lane.Points[i]
		local b = lane.Points[i + 1]
		local ab = b - a
		local len = ab.Magnitude
		if len > 0 then
			local t = math.clamp((flat - a):Dot(ab) / (len * len), 0, 1)
			local p = a + ab * t
			local d = (flat - p).Magnitude
			if d < bestD then
				bestD = d
				bestS = lane.Cum[i] + len * t
			end
		end
	end
	return bestS, bestD
end

-- Find a lane point between minDist and maxDist from pos, preferring points
-- behind `facing` (so police arrive from behind the player).
function Lanes.findSpawn(pos: Vector3, minDist: number, maxDist: number, facing: Vector3?): (CFrame?, Lane?)
	local best: CFrame? = nil
	local bestLane: Lane? = nil
	local bestScore = -math.huge
	for _, lane in all do
		local s0, d0 = Lanes.closest(lane, pos)
		if d0 < maxDist then
			for _, offset in { -maxDist * 0.6, -minDist * 1.2, minDist * 1.2, maxDist * 0.6 } do
				local p, dir = Lanes.sample(lane, s0 + offset)
				local dist = (p - Vector3.new(pos.X, 0, pos.Z)).Magnitude
				if dist >= minDist and dist <= maxDist then
					local score = -dist * 0.01 + math.random()
					if facing and facing.Magnitude > 0 then
						score -= (p - pos).Unit:Dot(facing.Unit) * 2
					end
					if score > bestScore then
						bestScore = score
						best = CFrame.lookAt(p, p + dir)
						bestLane = lane
					end
				end
			end
		end
	end
	return best, bestLane
end

return Lanes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- Builds the whole world procedurally at server start:
--   * a 10x10 block city with downtown towers, streetlights and a park
--   * a highway ring around the city
--   * a long interstate east to the outskirts
--   * quarter-mile and half-mile drag strips with christmas trees
--   * gas stations, garages, a police station, car-meet lots, speed cameras
-- Everything other systems need (lanes, pumps, zones...) is exposed in Layout.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local Lanes = require(script.Parent.Lanes)

local MapBuilder = {}

local M = Config.Map
local N = M.CityBlocks
local CELL = M.CellSize
local C = N * CELL / 2 -- city half extent (outer road centreline)
local RW = M.RoadWidth
local H = M.RingHalfSize
local HW = M.HighwayWidth / 2
local X0 = H + HW -- interstate start
local X1 = X0 + M.InterstateLength -- interstate end

local ROAD_TOP = 0.2
local WALK_TOP = 0.6
local LOT_TOP = 0.65
local MAX_PART = 2000

local ASPHALT = Color3.fromRGB(38, 38, 42)
local HIGHWAY = Color3.fromRGB(48, 48, 52)
local CONCRETE = Color3.fromRGB(160, 160, 155)
local WHITE = Color3.fromRGB(235, 235, 235)
local YELLOW = Color3.fromRGB(240, 190, 20)

local rng = Random.new(20261025)

export type TreeLights = { Stage: BasePart, Amber: { BasePart }, Green: BasePart, Red: BasePart }
export type Strip = {
	Name: string,
	StartX: number,
	FinishX: number,
	EndX: number,
	Lanes: { { Z: number, Tree: TreeLights } },
	Board: TextLabel,
}

MapBuilder.Layout = {
	GasPumps = {} :: { BasePart },
	Garages = {} :: { { Name: string, Terminal: BasePart, Pads: { CFrame } } },
	PoliceStation = CFrame.new(),
	Meets = {} :: { { Name: string, CFrame: CFrame, Size: Vector3 } },
	Strips = {} :: { [string]: Strip },
	SpeedCameras = {} :: { { Position: Vector3, Flash: BasePart } },
	Spawn = CFrame.new(),
	TrackBox = { Min = Vector3.new(7000, -50, -900), Max = Vector3.new(11300, 500, -60) },
}
local Layout = MapBuilder.Layout

local root: Folder
local folders: { [string]: Folder } = {}

----------------------------------------------------------------------
-- Part helpers
----------------------------------------------------------------------
local function newPart(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

-- Like newPart but splits anything longer than the engine's part size limit
local function box(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): { Part }
	local out = {}
	local longest = math.max(size.X, size.Z)
	if longest <= MAX_PART then
		table.insert(out, newPart(parent, size, cf, color, material))
		return out
	end
	local n = math.ceil(longest / MAX_PART)
	for i = 1, n do
		local f = (i - 0.5) / n - 0.5
		if size.X >= size.Z then
			local seg = Vector3.new(size.X / n, size.Y, size.Z)
			table.insert(out, newPart(parent, seg, cf * CFrame.new(f * size.X, 0, 0), color, material))
		else
			local seg = Vector3.new(size.X, size.Y, size.Z / n)
			table.insert(out, newPart(parent, seg, cf * CFrame.new(0, 0, f * size.Z), color, material))
		end
	end
	return out
end

-- Flat strip between two XZ points, with its top surface at topY
local function strip(parent: Instance, a: Vector3, b: Vector3, width: number, height: number, topY: number, color: Color3, material: Enum.Material?): { Part }
	local a2 = Vector3.new(a.X, 0, a.Z)
	local b2 = Vector3.new(b.X, 0, b.Z)
	local len = (b2 - a2).Magnitude
	local centre = (a2 + b2) / 2 + Vector3.new(0, topY - height / 2, 0)
	local cf = CFrame.lookAt(centre, centre + (b2 - a2).Unit)
	return box(parent, Vector3.new(width, height, len), cf, color, material)
end

local function v(x: number, z: number): Vector3
	return Vector3.new(x, 0, z)
end

local function sign(parent: Instance, text: string, size: Vector3, cf: CFrame, bg: Color3, fg: Color3): (Part, TextLabel)
	local p = newPart(parent, size, cf, bg, Enum.Material.SmoothPlastic)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = fg
	label.Parent = gui
	return p, label
end

local function prompt(parent: BasePart, action: string, object: string, hold: number, dist: number): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = hold
	pp.MaxActivationDistance = dist
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	return pp
end

local function lamp(parent: Instance, pos: Vector3, height: number, withLight: boolean)
	newPart(parent, Vector3.new(0.8, height, 0.8), CFrame.new(pos + Vector3.new(0, height / 2, 0)), Color3.fromRGB(60, 60, 65), Enum.Material.Metal)
	local head = newPart(parent, Vector3.new(3, 0.6, 1.6), CFrame.new(pos + Vector3.new(0, height, 0)), Color3.fromRGB(255, 230, 170), Enum.Material.Neon)
	head.CanCollide = false
	if withLight then
		local light = Instance.new("PointLight")
		light.Range = 60
		light.Brightness = 2
		light.Color = Color3.fromRGB(255, 220, 160)
		light.Parent = head
	end
end

local function tree(parent: Instance, pos: Vector3, scale: number)
	newPart(parent, Vector3.new(1.5, 10, 1.5) * scale, CFrame.new(pos + Vector3.new(0, 5 * scale, 0)), Color3.fromRGB(90, 60, 35), Enum.Material.Wood)
	local leaves = newPart(parent, Vector3.new(11, 11, 11) * scale, CFrame.new(pos + Vector3.new(0, 13 * scale, 0)), Color3.fromRGB(40, 110 + rng:NextInteger(0, 40), 45), Enum.Material.Grass)
	leaves.Shape = Enum.PartType.Ball
end

----------------------------------------------------------------------
-- Buildings & special lots
----------------------------------------------------------------------
local BUILDING_COLORS = {
	Color3.fromRGB(120, 120, 125),
	Color3.fromRGB(150, 140, 125),
	Color3.fromRGB(95, 70, 60),
	Color3.fromRGB(180, 175, 165),
	Color3.fromRGB(60, 70, 85),
	Color3.fromRGB(130, 90, 70),
	Color3.fromRGB(200, 195, 180),
}

local function buildBlockBuildings(centre: Vector3)
	local parent = folders.Buildings
	local d = math.clamp(centre.Magnitude / (C * 1.3), 0, 1)
	local downtown = (1 - d) ^ 2
	for lx = -1, 1, 2 do
		for lz = -1, 1, 2 do
			local fx = rng:NextNumber(60, 92)
			local fz = rng:NextNumber(60, 92)
			local h = 28 + downtown * 330 * rng:NextNumber(0.45, 1) + rng:NextNumber(0, 25)
			local pos = centre + Vector3.new(lx * 53, 0, lz * 53)
			local glassy = rng:NextNumber() < downtown * 0.8
			local color = BUILDING_COLORS[rng:NextInteger(1, #BUILDING_COLORS)]
			local material = if glassy
				then Enum.Material.Glass
				else ({ Enum.Material.Concrete, Enum.Material.Brick, Enum.Material.SmoothPlastic })[rng:NextInteger(1, 3)]
			if glassy then
				color = Color3.fromRGB(60, 85, 110)
			end
			local b = newPart(parent, Vector3.new(fx, h, fz), CFrame.new(pos + Vector3.new(0, WALK_TOP + h / 2, 0)), color, material)
			if glassy then
				b.Reflectance = 0.25
			end
			newPart(parent, Vector3.new(fx + 1, 2, fz + 1), CFrame.new(pos + Vector3.new(0, WALK_TOP + h + 1, 0)), Color3.fromRGB(50, 50, 55), Enum.Material.Concrete)
			if not glassy and h > 70 then
				local bands = math.min(10, math.floor(h / 28))
				for i = 1, bands do
					local band = newPart(parent, Vector3.new(fx + 0.4, 5, fz + 0.4), CFrame.new(pos + Vector3.new(0, WALK_TOP + i * 28 - 10, 0)), Color3.fromRGB(40, 55, 75), Enum.Material.Glass)
					band.Reflectance = 0.3
				end
			end
		end
	end
end

local function lotSlab(parent: Instance, centre: Vector3, size: Vector3, color: Color3, material: Enum.Material)
	newPart(parent, Vector3.new(size.X, 1, size.Z), CFrame.new(centre.X, LOT_TOP - 0.5, centre.Z), color, material)
end

local function buildGasStation(centre: Vector3, name: string)
	local parent = folders.Props
	lotSlab(parent, centre, Vector3.new(200, 1, 200), Color3.fromRGB(130, 130, 128), Enum.Material.Concrete)
	local base = Vector3.new(centre.X, LOT_TOP, centre.Z)
	-- canopy
	for _, o in { Vector3.new(-45, 0, -30), Vector3.new(45, 0, -30), Vector3.new(-45, 0, 30), Vector3.new(45, 0, 30) } do
		newPart(parent, Vector3.new(2, 18, 2), CFrame.new(base + o + Vector3.new(0, 9, 0)), WHITE, Enum.Material.SmoothPlastic)
	end
	newPart(parent, Vector3.new(110, 2, 80), CFrame.new(base + Vector3.new(0, 19, 0)), WHITE, Enum.Material.SmoothPlastic)
	local trim = newPart(parent, Vector3.new(110.4, 1, 80.4), CFrame.new(base + Vector3.new(0, 17.6, 0)), Color3.fromRGB(220, 30, 30), Enum.Material.Neon)
	trim.CanCollide = false
	-- pump islands
	for _, x in { -30, 0, 30 } do
		newPart(parent, Vector3.new(8, 0.6, 18), CFrame.new(base + Vector3.new(x, 0.3, 0)), CONCRETE, Enum.Material.Concrete)
		for _, z in { -5, 5 } do
			local pump = newPart(parent, Vector3.new(3, 6, 2), CFrame.new(base + Vector3.new(x, 3.6, z)), Color3.fromRGB(200, 30, 30), Enum.Material.SmoothPlastic)
			pump.Name = "GasPump"
			local screen = newPart(parent, Vector3.new(2, 1.4, 2.1), CFrame.new(base + Vector3.new(x, 5, z)), Color3.fromRGB(20, 20, 20), Enum.Material.Neon)
			screen.CanCollide = false
			prompt(pump, "Refuel", name, 0.6, 18)
			table.insert(Layout.GasPumps, pump)
		end
	end
	-- store
	newPart(parent, Vector3.new(70, 20, 36), CFrame.new(base + Vector3.new(0, 10, 75)), Color3.fromRGB(210, 205, 195), Enum.Material.Brick)
	sign(parent, name .. " MART", Vector3.new(40, 5, 0.5), CFrame.lookAt(base + Vector3.new(0, 16, 56.8), base + Vector3.new(0, 16, 0)), Color3.fromRGB(200, 30, 30), WHITE)
	-- price sign
	newPart(parent, Vector3.new(1.5, 26, 1.5), CFrame.new(base + Vector3.new(85, 13, -85)), Color3.fromRGB(60, 60, 60), Enum.Material.Metal)
	sign(parent, string.format("GAS\n$%.2f", Config.GasPricePerGallon), Vector3.new(14, 12, 1), CFrame.new(base + Vector3.new(85, 30, -85)), Color3.fromRGB(20, 20, 20), YELLOW)
end

local function buildGarage(centre: Vector3, name: string, facing: Vector3)
	local parent = folders.Props
	-- local frame: building at the back, pads at the front facing the road
	local cf = CFrame.lookAt(Vector3.new(centre.X, LOT_TOP, centre.Z), Vector3.new(centre.X, LOT_TOP, centre.Z) + facing)
	lotSlab(parent, centre, Vector3.new(210, 1, 210), Color3.fromRGB(45, 45, 50), Enum.Material.Asphalt)
	local wallColor = Color3.fromRGB(30, 30, 36)
	newPart(parent, Vector3.new(130, 32, 2), cf * CFrame.new(0, 16, 95), wallColor, Enum.Material.Metal)
	newPart(parent, Vector3.new(2, 32, 60), cf * CFrame.new(-65, 16, 66), wallColor, Enum.Material.Metal)
	newPart(parent, Vector3.new(2, 32, 60), cf * CFrame.new(65, 16, 66), wallColor, Enum.Material.Metal)
	newPart(parent, Vector3.new(132, 2, 62), cf * CFrame.new(0, 33, 66), wallColor, Enum.Material.Metal)
	local neon = newPart(parent, Vector3.new(132, 1, 1), cf * CFrame.new(0, 31.5, 36), Color3.fromRGB(0, 170, 255), Enum.Material.Neon)
	neon.CanCollide = false
	sign(parent, name, Vector3.new(80, 10, 1), cf * CFrame.new(0, 40, 36), Color3.fromRGB(15, 15, 20), Color3.fromRGB(0, 200, 255))
	for i = -1, 1 do
		local l = Instance.new("PointLight")
		l.Range = 40
		l.Brightness = 1.5
		l.Parent = newPart(parent, Vector3.new(6, 0.4, 6), cf * CFrame.new(i * 40, 31.8, 66), Color3.fromRGB(255, 255, 240), Enum.Material.Neon)
	end
	local terminal = newPart(parent, Vector3.new(4, 7, 2), cf * CFrame.new(0, 3.5, 40), Color3.fromRGB(0, 120, 220), Enum.Material.Neon)
	terminal.Name = "GarageTerminal"
	prompt(terminal, "Open Garage", name, 0, 16)
	local pads = {}
	for i = -1, 1 do
		local padCf = cf * CFrame.new(i * 40, 0, -40)
		local pad = newPart(parent, Vector3.new(14, 0.1, 22), padCf * CFrame.new(0, 0.05, 0), Color3.fromRGB(0, 170, 255), Enum.Material.Neon)
		pad.Transparency = 0.6
		pad.CanCollide = false
		pad.CanQuery = false
		-- cars spawn facing the road
		table.insert(pads, CFrame.lookAt(padCf.Position, padCf.Position + facing))
	end
	table.insert(Layout.Garages, { Name = name, Terminal = terminal, Pads = pads })
end

local function buildMeet(centre: Vector3, size: Vector3, name: string)
	local parent = folders.Props
	lotSlab(parent, centre, size, Color3.fromRGB(30, 30, 34), Enum.Material.Asphalt)
	local base = Vector3.new(centre.X, LOT_TOP, centre.Z)
	-- parking stripes in two rows
	for _, rowZ in { -size.Z / 4, size.Z / 4 } do
		local x = -size.X / 2 + 14
		while x < size.X / 2 - 7 do
			local s = newPart(parent, Vector3.new(0.5, 0.05, 22), CFrame.new(base + Vector3.new(x, 0.03, rowZ)), WHITE, Enum.Material.SmoothPlastic)
			s.CanCollide = false
			x += 14
		end
	end
	for _, o in { Vector3.new(-1, 0, -1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, 1) } do
		lamp(parent, base + Vector3.new(o.X * (size.X / 2 - 4), 0, o.Z * (size.Z / 2 - 4)), 24, true)
	end
	newPart(parent, Vector3.new(1.5, 18, 1.5), CFrame.new(base + Vector3.new(0, 9, -size.Z / 2 + 2)), Color3.fromRGB(60, 60, 60), Enum.Material.Metal)
	local s = sign(parent, "CAR MEET\n" .. string.upper(name), Vector3.new(30, 10, 1), CFrame.new(base + Vector3.new(0, 22, -size.Z / 2 + 2)), Color3.fromRGB(15, 10, 25), Color3.fromRGB(255, 60, 200))
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 60, 200)
	glow.Range = 30
	glow.Parent = s
	table.insert(Layout.Meets, { Name = name, CFrame = CFrame.new(base + Vector3.new(0, 10, 0)), Size = Vector3.new(size.X, 30, size.Z) })
end

local function buildPoliceStation(centre: Vector3)
	local parent = folders.Props
	lotSlab(parent, centre, Vector3.new(210, 1, 210), Color3.fromRGB(70, 70, 75), Enum.Material.Asphalt)
	local base = Vector3.new(centre.X, LOT_TOP, centre.Z)
	newPart(parent, Vector3.new(150, 40, 80), CFrame.new(base + Vector3.new(0, 20, 50)), Color3.fromRGB(200, 205, 215), Enum.Material.Concrete)
	newPart(parent, Vector3.new(150.4, 4, 80.4), CFrame.new(base + Vector3.new(0, 30, 50)), Color3.fromRGB(20, 50, 140), Enum.Material.SmoothPlastic)
	sign(parent, "POLICE", Vector3.new(50, 10, 1), CFrame.lookAt(base + Vector3.new(0, 34, 9.4), base + Vector3.new(0, 34, -10)), Color3.fromRGB(20, 50, 140), WHITE)
	Layout.PoliceStation = CFrame.lookAt(base + Vector3.new(0, 3, 0), base + Vector3.new(0, 3, -10))
end

local function buildPark(centre: Vector3)
	local parent = folders.Props
	lotSlab(parent, centre, Vector3.new(212, 1, 212), Color3.fromRGB(60, 140, 60), Enum.Material.Grass)
	local base = Vector3.new(centre.X, LOT_TOP, centre.Z)
	for _ = 1, 16 do
		tree(parent, base + Vector3.new(rng:NextNumber(-95, 95), 0, rng:NextNumber(-95, 95)), rng:NextNumber(0.8, 1.4))
	end
	local f = newPart(parent, Vector3.new(30, 2, 30), CFrame.new(base + Vector3.new(0, 1, 0)), CONCRETE, Enum.Material.Concrete)
	f.Shape = Enum.PartType.Cylinder
	f.CFrame = CFrame.new(base + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	local water = newPart(parent, Vector3.new(1, 26, 26), CFrame.new(base + Vector3.new(0, 1.8, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(60, 140, 220), Enum.Material.Glass)
	water.Shape = Enum.PartType.Cylinder
	water.Transparency = 0.3
end

local function speedCamera(pos: Vector3)
	local parent = folders.Props
	newPart(parent, Vector3.new(1, 14, 1), CFrame.new(pos + Vector3.new(0, 7, 0)), Color3.fromRGB(70, 70, 70), Enum.Material.Metal)
	newPart(parent, Vector3.new(2.5, 2.5, 3.5), CFrame.new(pos + Vector3.new(0, 15, 0)), Color3.fromRGB(230, 180, 20), Enum.Material.SmoothPlastic)
	local flash = newPart(parent, Vector3.new(1.2, 1.2, 0.3), CFrame.new(pos + Vector3.new(0, 15, -1.9)), Color3.fromRGB(80, 80, 80), Enum.Material.SmoothPlastic)
	flash.CanCollide = false
	table.insert(Layout.SpeedCameras, { Position = pos, Flash = flash })
end

----------------------------------------------------------------------
-- Roads
----------------------------------------------------------------------
-- Barrier along a->b at `offset` (to the right of travel), leaving gaps
-- centred at the given distances along the barrier.
local function barrier(a: Vector3, b: Vector3, offset: number, gaps: { number }, gapWidth: number)
	local dir = (b - a).Unit
	local right = dir:Cross(Vector3.yAxis)
	local len = (b - a).Magnitude
	table.sort(gaps)
	local cursor = 0
	local function piece(from: number, to: number)
		if to - from > 2 then
			strip(folders.Roads, a + dir * from + right * offset, a + dir * to + right * offset, 1.6, 3.2, ROAD_TOP + 3, CONCRETE, Enum.Material.Concrete)
		end
	end
	for _, g in gaps do
		piece(cursor, g - gapWidth / 2)
		cursor = g + gapWidth / 2
	end
	piece(cursor, len)
end

-- A multi-lane divided road along a->b (centreline), markings inset from the ends
local function divided(a: Vector3, b: Vector3, halfWidth: number, extend: number, inset: number, color: Color3)
	local dir = (b - a).Unit
	local right = dir:Cross(Vector3.yAxis)
	strip(folders.Roads, a - dir * extend, b + dir * extend, halfWidth * 2, 1, ROAD_TOP, color, Enum.Material.Asphalt)
	local la, lb = a + dir * inset, b - dir * inset
	for _, o in { -halfWidth + 2, -24, 24, halfWidth - 2 } do
		strip(folders.Roads, la + right * o, lb + right * o, 0.5, 0.1, ROAD_TOP + 0.05, WHITE)
	end
	for _, o in { -1, 1 } do
		strip(folders.Roads, la + right * o, lb + right * o, 0.5, 0.1, ROAD_TOP + 0.05, YELLOW)
	end
end

local function cityRoad(a: Vector3, b: Vector3)
	strip(folders.Roads, a, b, RW, 1, ROAD_TOP, ASPHALT, Enum.Material.Asphalt)
	strip(folders.Roads, a, b, 0.6, 0.1, ROAD_TOP + 0.05, YELLOW)
end

local function buildGround()
	for x = -2600, 11600, 2000 do
		for z = -2600, 2600, 2000 do
			newPart(folders.Ground, Vector3.new(2000, 2, 2000), CFrame.new(x + 1000, -1, z + 1000), Color3.fromRGB(80, 140, 65), Enum.Material.Grass)
		end
	end
	-- scenic hills at the edges
	for i = 1, 14 do
		local x = rng:NextNumber(-2400, 11000)
		local z = if i % 2 == 0 then rng:NextNumber(2300, 3200) else -rng:NextNumber(2300, 3200)
		local r = rng:NextNumber(500, 1100)
		local hill = newPart(folders.Ground, Vector3.new(r, r, r), CFrame.new(x, -r * 0.3, z), Color3.fromRGB(70, 125, 60), Enum.Material.Grass)
		hill.Shape = Enum.PartType.Ball
	end
end

local function buildCity()
	local ext = C + RW / 2
	for i = 0, N do
		local p = -C + i * CELL
		cityRoad(v(p, -ext), v(p, ext))
		cityRoad(v(-ext, p), v(ext, p))
	end
	-- connectors from the city out to the ring
	local inner = H - HW
	cityRoad(v(0, -ext), v(0, -inner))
	cityRoad(v(0, ext), v(0, inner))
	cityRoad(v(-ext, 0), v(-inner, 0))
	cityRoad(v(ext, 0), v(inner, 0))

	-- streetlights at every intersection
	for i = 0, N do
		for j = 0, N do
			lamp(folders.Props, Vector3.new(-C + i * CELL + RW / 2 + 3, WALK_TOP, -C + j * CELL + RW / 2 + 3), 22, false)
		end
	end

	local special: { [string]: (Vector3) -> () } = {
		["5,5"] = function(c)
			buildGarage(c, "MIDNIGHT MOTORS", Vector3.new(0, 0, -1))
		end,
		["3,6"] = buildPoliceStation,
		["1,1"] = function(c)
			buildGasStation(c, "FUEL STOP")
		end,
		["8,1"] = function(c)
			buildGasStation(c, "QUICK GAS")
		end,
		["1,8"] = function(c)
			buildGasStation(c, "PETRO")
		end,
		["8,8"] = function(c)
			buildGasStation(c, "FUEL STOP")
		end,
		["6,3"] = function(c)
			buildMeet(c, Vector3.new(212, 1, 212), "Downtown Lot")
		end,
		["2,7"] = function(c)
			buildMeet(c, Vector3.new(212, 1, 212), "Neon Plaza")
		end,
		["4,4"] = buildPark,
	}

	for i = 0, N - 1 do
		for j = 0, N - 1 do
			local centre = Vector3.new(-C + (i + 0.5) * CELL, 0, -C + (j + 0.5) * CELL)
			local walk = CELL - RW
			newPart(folders.Roads, Vector3.new(walk, 1, walk), CFrame.new(centre.X, WALK_TOP - 0.5, centre.Z), Color3.fromRGB(150, 150, 145), Enum.Material.Concrete)
			local fn = special[i .. "," .. j]
			if fn then
				fn(centre)
			else
				buildBlockBuildings(centre)
			end
		end
	end
end

local function buildRing()
	local corners = { v(-H, -H), v(H, -H), v(H, H), v(-H, H) }
	for i = 1, 4 do
		local a = corners[i]
		local b = corners[i % 4 + 1]
		divided(a, b, HW, HW, HW, HIGHWAY)
		local dir = (b - a).Unit
		local sideLen = 2 * H
		-- outer barrier (to the left of a->b on this winding) and inner barrier
		local outerGaps = {}
		if i == 2 then
			table.insert(outerGaps, (sideLen + 2 * (HW + 1)) / 2) -- interstate junction on the east side
		end
		barrier(a - dir * (HW + 1), b + dir * (HW + 1), -(HW + 1), outerGaps, M.HighwayWidth + 8)
		barrier(a + dir * (HW + 1), b - dir * (HW + 1), HW + 1, { (sideLen - 2 * (HW + 1)) / 2 }, RW + 20)
		-- speed cameras a quarter of the way along each side
		local camPos = a + dir * (sideLen * 0.25)
		local outward = -dir:Cross(Vector3.yAxis)
		speedCamera(camPos + outward * (HW + 5) + Vector3.new(0, ROAD_TOP, 0))
	end

	-- outer lanes run one way, inner lanes the other (median on the driver's left)
	for _, o in { 14, 34 } do
		local r = H + o
		Lanes.add("RingOuter" .. o, "Highway", { v(r, r), v(r, -r), v(-r, -r), v(-r, r) }, if o == 14 then 104 else 88)
		local q = H - o
		Lanes.add("RingInner" .. o, "Highway", { v(q, q), v(-q, q), v(-q, -q), v(q, -q) }, if o == 14 then 104 else 88)
	end
end

local function buildInterstate()
	local a, b = v(X0, 0), v(X1, 0)
	divided(a, b, HW, 0, 0, HIGHWAY)
	local gasX, restX, trackX = H + 2500, H + 4200, 7350
	-- barriers: north side is to the left of a->b (negative offset)
	barrier(a, b, HW + 1, { gasX - X0 }, 70)
	barrier(a, b, -(HW + 1), { restX - X0, trackX - X0 }, 70)
	strip(folders.Roads, v(X1, -HW - 2), v(X1, HW + 2), 3, 6, ROAD_TOP + 6, CONCRETE, Enum.Material.Concrete)

	for x = X0 + 300, X1 - 100, 300 do
		lamp(folders.Props, Vector3.new(x, ROAD_TOP, 0), 30, false)
	end
	for _, x in { 3500, 5300, 8200 } do
		speedCamera(Vector3.new(x, ROAD_TOP, HW + 5))
		speedCamera(Vector3.new(x + 400, ROAD_TOP, -HW - 5))
	end
	-- billboards
	for i, x in { 2600, 4800, 6600 } do
		local text = ({ "MIDNIGHT MOTORS\nUPGRADE YOUR RIDE", "DRAG STRIP\nNEXT EXIT ->", "OBEY THE LIMIT\n70 MPH" })[i]
		newPart(folders.Props, Vector3.new(2, 30, 2), CFrame.new(x, 15, -120), Color3.fromRGB(60, 60, 60), Enum.Material.Metal)
		sign(folders.Props, text, Vector3.new(60, 20, 1), CFrame.lookAt(Vector3.new(x, 38, -120), Vector3.new(x, 38, 0)), Color3.fromRGB(20, 20, 30), Color3.fromRGB(255, 200, 40))
	end

	-- exits
	strip(folders.Roads, v(gasX, HW - 2), v(gasX, 62), 50, 1, ROAD_TOP, ASPHALT, Enum.Material.Asphalt)
	buildGasStation(Vector3.new(gasX, 0, 160), "HIGHWAY 9")
	strip(folders.Roads, v(restX, -HW + 2), v(restX, -62), 50, 1, ROAD_TOP, ASPHALT, Enum.Material.Asphalt)
	buildMeet(Vector3.new(restX, 0, -175), Vector3.new(240, 1, 220), "Rest Stop")

	for _, o in { 14, 34 } do
		Lanes.add("Interstate" .. o, "Interstate", { v(X0 + 10, o), v(X1 - 20, o), v(X1 - 20, -o), v(X0 + 10, -o) }, if o == 14 then 112 else 94)
	end
	for _, R in { C, CELL * 3, CELL } do
		local r = R + 13
		Lanes.add("CityOuter" .. R, "City", { v(r, r), v(r, -r), v(-r, -r), v(-r, r) }, 60)
		local q = R - 13
		Lanes.add("CityInner" .. R, "City", { v(q, q), v(-q, q), v(-q, -q), v(q, -q) }, 60)
	end
end

local function buildTree(parent: Instance, x: number, laneZs: { number }): { TreeLights }
	local mid = (laneZs[1] + laneZs[2]) / 2
	newPart(parent, Vector3.new(1, 14, 1), CFrame.new(x, ROAD_TOP + 7, mid), Color3.fromRGB(30, 30, 30), Enum.Material.Metal)
	local out = {}
	for li, z in laneZs do
		local side = if z < mid then -1 else 1
		local function light(y: number, color: Color3): BasePart
			local p = newPart(parent, Vector3.new(1, 1, 1), CFrame.new(x - 0.6, ROAD_TOP + y, mid + side * 1.2), color, Enum.Material.SmoothPlastic)
			p.Shape = Enum.PartType.Ball
			p.CanCollide = false
			p:SetAttribute("OnColor", color)
			p.Color = Color3.fromRGB(35, 35, 35)
			return p
		end
		out[li] = {
			Stage = light(13, Color3.fromRGB(255, 255, 255)),
			Amber = { light(11, Color3.fromRGB(255, 170, 0)), light(9.6, Color3.fromRGB(255, 170, 0)), light(8.2, Color3.fromRGB(255, 170, 0)) },
			Green = light(6.8, Color3.fromRGB(0, 255, 60)),
			Red = light(5.4, Color3.fromRGB(255, 0, 0)),
		}
	end
	return out
end

local function buildStrip(name: string, centreZ: number, length: number)
	local parent = folders.Track
	local startX = 7600
	local finishX = startX + length
	local endX = finishX + 600
	strip(parent, v(7450, centreZ), v(endX, centreZ), 44, 1, ROAD_TOP + 0.05, Color3.fromRGB(55, 55, 58), Enum.Material.Concrete)
	strip(parent, v(7450, centreZ), v(endX, centreZ), 0.6, 0.1, ROAD_TOP + 0.1, WHITE)
	for _, o in { -23, 23 } do
		strip(parent, v(7470, centreZ + o), v(endX, centreZ + o), 1.6, 3.5, ROAD_TOP + 3.5, Color3.fromRGB(230, 230, 230), Enum.Material.Concrete)
	end
	strip(parent, v(endX, centreZ - 23), v(endX, centreZ + 23), 4, 6, ROAD_TOP + 6, Color3.fromRGB(210, 40, 40), Enum.Material.Concrete)
	strip(parent, v(startX, centreZ - 22), v(startX, centreZ + 22), 1, 0.1, ROAD_TOP + 0.12, WHITE)
	-- checkered finish line
	for i = 0, 21 do
		for j = 0, 1 do
			local c = if (i + j) % 2 == 0 then WHITE else Color3.fromRGB(15, 15, 15)
			local p = newPart(parent, Vector3.new(1, 0.1, 2), CFrame.new(finishX + j - 0.5, ROAD_TOP + 0.12, centreZ - 21 + i * 2), c)
			p.CanCollide = false
		end
	end
	for _, o in { -24, 24 } do
		newPart(parent, Vector3.new(2, 24, 2), CFrame.new(finishX, ROAD_TOP + 12, centreZ + o), Color3.fromRGB(30, 30, 30), Enum.Material.Metal)
	end
	sign(parent, "FINISH", Vector3.new(1, 6, 50), CFrame.new(finishX, ROAD_TOP + 26, centreZ) * CFrame.Angles(0, -math.pi / 2, 0), Color3.fromRGB(15, 15, 15), WHITE)

	local laneZs = { centreZ - 11, centreZ + 11 }
	local trees = buildTree(parent, startX - 4, laneZs)
	local _, board = sign(parent, name .. "\nREADY", Vector3.new(30, 12, 1), CFrame.lookAt(Vector3.new(7470, 20, centreZ + (if centreZ > -470 then 40 else -40)), Vector3.new(7400, 20, centreZ + (if centreZ > -470 then 40 else -40))), Color3.fromRGB(10, 10, 10), Color3.fromRGB(255, 200, 0))
	newPart(parent, Vector3.new(1.5, 14, 1.5), CFrame.new(7470, 7, centreZ + (if centreZ > -470 then 40 else -40)), Color3.fromRGB(40, 40, 40), Enum.Material.Metal)

	Layout.Strips[name] = {
		Name = name,
		StartX = startX,
		FinishX = finishX,
		EndX = endX,
		Lanes = { { Z = laneZs[1], Tree = trees[1] }, { Z = laneZs[2], Tree = trees[2] } },
		Board = board,
	}
end

local function buildTrackComplex()
	-- access road off the interstate
	strip(folders.Roads, v(7350, -HW + 2), v(7350, -840), 44, 1, ROAD_TOP, ASPHALT, Enum.Material.Asphalt)
	strip(folders.Roads, v(7350, -HW + 2), v(7350, -840), 0.6, 0.1, ROAD_TOP + 0.05, YELLOW)
	-- pit / staging lot
	lotSlab(folders.Track, Vector3.new(7416, 0, -470), Vector3.new(92, 1, 270), Color3.fromRGB(50, 50, 55), Enum.Material.Asphalt)

	buildStrip("Quarter", -400, M.QuarterMile)
	buildStrip("Half", -540, M.HalfMile)

	-- grandstand between the strip and the interstate
	for i = 0, 5 do
		newPart(folders.Track, Vector3.new(900, 2 + i * 2, 8), CFrame.new(8300, (2 + i * 2) / 2, -355 + i * 8), Color3.fromRGB(120, 125, 135), Enum.Material.Concrete)
	end
	newPart(folders.Track, Vector3.new(900, 1, 50), CFrame.new(8300, 26, -335), Color3.fromRGB(200, 30, 30), Enum.Material.Metal)
	for x = 7900, 8700, 200 do
		newPart(folders.Track, Vector3.new(1.5, 26, 1.5), CFrame.new(x, 13, -312), Color3.fromRGB(60, 60, 60), Enum.Material.Metal)
	end
	-- light towers along the strips
	for x = 7700, 10900, 400 do
		lamp(folders.Track, Vector3.new(x, ROAD_TOP, -620), 40, x < 9200)
	end

	buildGarage(Vector3.new(7190, 0, -200), "STRIP GARAGE", Vector3.new(1, 0, 0))
	buildMeet(Vector3.new(7190, 0, -470), Vector3.new(260, 1, 220), "Strip Meet")
	buildGasStation(Vector3.new(7190, 0, -720), "PIT FUEL")
end

local function inBand(x: number, z: number): boolean
	if math.abs(x) < C + 80 and math.abs(z) < C + 80 then
		return true
	end
	if math.abs(math.max(math.abs(x), math.abs(z)) - H) < HW + 40 then
		return true
	end
	if x > H and x < X1 + 50 and math.abs(z) < HW + 40 then
		return true
	end
	if x > 6950 and x < 11300 and z > -950 and z < -30 then
		return true
	end
	if (math.abs(x) < 40 or math.abs(z) < 40) and math.abs(x) < H and math.abs(z) < H then
		return true -- connector roads
	end
	if math.abs(z) < 300 and (math.abs(x - (H + 2500)) < 140 or math.abs(x - (H + 4200)) < 150) then
		return true
	end
	return false
end

local function buildCountryside()
	local placed = 0
	local attempts = 0
	while placed < 260 and attempts < 4000 do
		attempts += 1
		local x = rng:NextNumber(-2500, 11200)
		local z = rng:NextNumber(-2400, 2400)
		if not inBand(x, z) then
			tree(folders.Props, Vector3.new(x, 0, z), rng:NextNumber(0.9, 1.8))
			placed += 1
		end
	end
end

local function buildLighting()
	Lighting.Brightness = 2.2
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 130)
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atm = Instance.new("Atmosphere")
		atm.Density = 0.28
		atm.Haze = 1.2
		atm.Color = Color3.fromRGB(200, 190, 210)
		atm.Decay = Color3.fromRGB(100, 90, 120)
		atm.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.6
		bloom.Size = 30
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
	end
end

----------------------------------------------------------------------
-- Zone queries
----------------------------------------------------------------------
function MapBuilder.isOnTrack(pos: Vector3): boolean
	local b = Layout.TrackBox
	return pos.X > b.Min.X and pos.X < b.Max.X and pos.Z > b.Min.Z and pos.Z < b.Max.Z
end

function MapBuilder.getZone(pos: Vector3): string
	if MapBuilder.isOnTrack(pos) then
		return "Track"
	end
	local x, z = pos.X, pos.Z
	if math.abs(math.max(math.abs(x), math.abs(z)) - H) <= HW + 2 then
		return "Highway"
	end
	if x >= X0 - 2 and x <= X1 and math.abs(z) <= HW + 2 then
		return "Highway"
	end
	if math.abs(x) <= C + RW and math.abs(z) <= C + RW then
		return "City"
	end
	return "Rural"
end

function MapBuilder.meetAt(pos: Vector3): string?
	for _, meet in Layout.Meets do
		local rel = meet.CFrame:PointToObjectSpace(pos)
		if math.abs(rel.X) <= meet.Size.X / 2 and math.abs(rel.Z) <= meet.Size.Z / 2 and math.abs(rel.Y) <= meet.Size.Y / 2 then
			return meet.Name
		end
	end
	return nil
end

function MapBuilder.init()
	root = Instance.new("Folder")
	root.Name = "Map"
	for _, name in { "Ground", "Roads", "Buildings", "Props", "Track" } do
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = root
		folders[name] = f
	end

	buildLighting()
	buildGround()
	buildCity()
	buildRing()
	buildInterstate()
	buildTrackComplex()
	buildCountryside()

	-- player spawn at the downtown garage
	local garage = Layout.Garages[1]
	local spawnPos = garage.Terminal.Position + Vector3.new(0, 0, -20)
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(spawnPos.X, LOT_TOP + 0.5, spawnPos.Z)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.CanQuery = false -- car suspension raycasts must not ride on it
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = root
	Layout.Spawn = spawn.CFrame

	root.Parent = workspace
end

return MapBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Meets</string><ProtectedString name="Source"><![CDATA[--!strict
-- Car meets: park your car in a meet lot to show it off. Every payout interval
-- each parked owner earns cash scaled by how many cars are at the meet.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local PlayerData = require(script.Parent.PlayerData)
local MapBuilder = require(script.Parent.MapBuilder)
local CarService = require(script.Parent.CarService)

local Meets = {}

function Meets.init() end

function Meets.start()
	local payoutTimer = 0
	while true do
		local dt = task.wait(1)
		payoutTimer += dt

		-- which meet is each player's car parked at?
		local parkedAt: { [Player]: string } = {}
		local counts: { [string]: number } = {}
		for _, player in Players:GetPlayers() do
			local car = CarService.getCar(player)
			local chassis = car and car:FindFirstChild("Chassis") :: BasePart?
			if chassis and chassis.AssemblyLinearVelocity.Magnitude < 3 then
				local meet = MapBuilder.meetAt(chassis.Position)
				if meet then
					parkedAt[player] = meet
					counts[meet] = (counts[meet] or 0) + 1
				end
			end
		end

		for _, player in Players:GetPlayers() do
			local meet = parkedAt[player]
			player:SetAttribute("Meet", meet or "")
			player:SetAttribute("MeetCount", if meet then counts[meet] else 0)
		end

		if payoutTimer >= Config.Meet.PayoutInterval then
			payoutTimer = 0
			for player, meet in parkedAt do
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				local car = CarService.getCar(player)
				-- the owner has to actually be hanging out at the meet
				if root and car and (root.Position - car:GetPivot().Position).Magnitude < 200 then
					PlayerData.addCash(player, Config.Meet.PayPerCar * counts[meet], "Car meet rep (" .. meet .. ")")
				end
			end
		end
	end
end

return Meets
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source"><![CDATA[--!strict
-- Player profiles: load/save with retries, autosave, BindToClose, schema
-- versioning. If a load fails we never save over the player's real data.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CarStats = require(Shared.CarStats)
local Remotes = require(Shared.Remotes)

local SCHEMA_VERSION = 1
local AUTOSAVE_INTERVAL = 120

local PlayerData = {}

export type Profile = {
	Version: number,
	Cash: number,
	Cars: { [string]: CarStats.CarData },
	Selected: string,
	Best: { [string]: number },
	Stats: { [string]: number },
}

type Session = {
	profile: Profile,
	canSave: boolean,
	dirty: boolean,
}

local sessions: { [Player]: Session } = {}
local store: DataStore? = nil
local listeners: { (Player, Profile) -> () } = {}

local function defaultProfile(): Profile
	return {
		Version = SCHEMA_VERSION,
		Cash = Config.StartingCash,
		Cars = { Hatch = CarStats.defaultData("Hatch") },
		Selected = "Hatch",
		Best = {},
		Stats = { Busts = 0, Escapes = 0, Races = 0, Wins = 0, Tickets = 0, Miles = 0 },
	}
end

-- Fill in any fields added since the profile was saved
local function reconcile(data: any): Profile
	local base = defaultProfile()
	if typeof(data) ~= "table" then
		return base
	end
	local p: any = data
	p.Version = SCHEMA_VERSION
	p.Cash = if typeof(p.Cash) == "number" then p.Cash else base.Cash
	p.Cars = if typeof(p.Cars) == "table" then p.Cars else base.Cars
	p.Best = if typeof(p.Best) == "table" then p.Best else {}
	p.Stats = if typeof(p.Stats) == "table" then p.Stats else base.Stats
	for k, v in base.Stats do
		if p.Stats[k] == nil then
			p.Stats[k] = v
		end
	end
	for carId, carData in p.Cars do
		if not Config.Cars[carId] then
			p.Cars[carId] = nil
			continue
		end
		local def = CarStats.defaultData(carId)
		for _, section in { "Upgrades", "Cosmetics", "Tuning" } do
			if typeof(carData[section]) ~= "table" then
				carData[section] = def[section]
			else
				for k, v in (def :: any)[section] do
					if carData[section][k] == nil then
						carData[section][k] = v
					end
				end
			end
		end
	end
	if next(p.Cars) == nil then
		p.Cars.Hatch = CarStats.defaultData("Hatch")
	end
	if typeof(p.Selected) ~= "string" or not p.Cars[p.Selected] then
		p.Selected = next(p.Cars) :: string
	end
	return p :: Profile
end

local function withRetries<T>(fn: () -> T): (boolean, T | string)
	local lastErr: any
	for attempt = 1, 4 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		task.wait(2 ^ attempt)
	end
	return false, tostring(lastErr)
end

local function keyFor(player: Player): string
	return "p_" .. player.UserId
end

local function save(player: Player)
	local session = sessions[player]
	if not session or not session.canSave or not store then
		return
	end
	local snapshot = session.profile
	local ok, err = withRetries(function()
		return (store :: DataStore):UpdateAsync(keyFor(player), function()
			return snapshot
		end)
	end)
	if ok then
		session.dirty = false
	else
		warn("[PlayerData] save failed for", player.Name, err)
	end
end

local function updateLeaderstats(player: Player, profile: Profile)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local cash = ls:FindFirstChild("Cash") :: IntValue?
		if cash then
			cash.Value = math.floor(profile.Cash)
		end
	end
end

function PlayerData.get(player: Player): Profile?
	local s = sessions[player]
	return s and s.profile
end

function PlayerData.waitFor(player: Player): Profile?
	local t = 0
	while not sessions[player] and player.Parent and t < 30 do
		t += task.wait(0.1)
	end
	return PlayerData.get(player)
end

-- Call after every mutation so the client UI stays in sync
function PlayerData.changed(player: Player)
	local s = sessions[player]
	if not s then
		return
	end
	s.dirty = true
	updateLeaderstats(player, s.profile)
	Remotes.event("ProfileUpdated"):FireClient(player, s.profile)
	for _, fn in listeners do
		task.spawn(fn, player, s.profile)
	end
end

function PlayerData.onChanged(fn: (Player, Profile) -> ())
	table.insert(listeners, fn)
end

function PlayerData.addCash(player: Player, amount: number, reason: string?)
	local p = PlayerData.get(player)
	if not p or amount ~= amount then
		return
	end
	p.Cash = math.max(0, math.floor(p.Cash + amount))
	PlayerData.changed(player)
	if reason and amount ~= 0 then
		local sign = if amount > 0 then "+" else "-"
		Remotes.event("Notify"):FireClient(player, string.format("%s$%d  %s", sign, math.abs(math.floor(amount)), reason), if amount > 0 then "money" else "warn")
	end
end

function PlayerData.trySpend(player: Player, amount: number): boolean
	local p = PlayerData.get(player)
	if not p or amount < 0 or p.Cash < amount then
		return false
	end
	p.Cash -= amount
	PlayerData.changed(player)
	return true
end

function PlayerData.bumpStat(player: Player, stat: string, by: number)
	local p = PlayerData.get(player)
	if p then
		p.Stats[stat] = (p.Stats[stat] or 0) + by
		PlayerData.changed(player)
	end
end

local function onPlayerAdded(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Parent = ls
	ls.Parent = player

	local profile: Profile
	local canSave = false
	if store then
		local ok, result = withRetries(function()
			return (store :: DataStore):GetAsync(keyFor(player))
		end)
		if ok then
			profile = reconcile(result)
			canSave = true
		else
			warn("[PlayerData] load failed, playing with a temporary profile:", result)
			profile = defaultProfile()
		end
	else
		profile = defaultProfile()
	end
	if not player.Parent then
		return
	end
	sessions[player] = { profile = profile, canSave = canSave, dirty = false }
	PlayerData.changed(player)
	if not canSave and store then
		Remotes.event("Notify"):FireClient(player, "Could not load your save. Progress this session will not be saved.", "warn")
	end
end

local function onPlayerRemoving(player: Player)
	save(player)
	sessions[player] = nil
end

function PlayerData.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("MidnightMotors_v1")
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStores unavailable (enable Studio API access to test saving):", result)
	end

	Remotes.func("GetProfile").OnServerInvoke = function(player: Player)
		return PlayerData.waitFor(player)
	end
end

function PlayerData.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local threads = {}
		for player in sessions do
			table.insert(threads, task.spawn(save, player))
		end
		local t = 0
		while t < 25 do
			local busy = false
			for _, th in threads do
				if coroutine.status(th) ~= "dead" then
					busy = true
				end
			end
			if not busy then
				break
			end
			t += task.wait(0.5)
		end
	end)

	while true do
		task.wait(AUTOSAVE_INTERVAL)
		for player, session in sessions do
			if session.dirty then
				task.spawn(save, player)
			end
		end
	end
end

return PlayerData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Police</string><ProtectedString name="Source"><![CDATA[--!strict
-- Police: detects traffic violations (speeding, swerving, reckless driving,
-- hitting police) when a patrol car or speed camera witnesses them, then runs
-- a escalating chase:
--   heat 1  pull-over attempt: stop for a few seconds and you only get a ticket
--   heat 2+ pursuit: more units, interceptors, SUVs, roadblocks, spike strips
--   heat 5  helicopter
-- Stop near a unit long enough and you're BUSTED (fine + impound); get far
-- enough away for long enough and you ESCAPE (reward).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CarStats = require(Shared.CarStats)
local CarPhysics = require(Shared.CarPhysics)
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)
local MapBuilder = require(script.Parent.MapBuilder)
local CarFactory = require(script.Parent.CarFactory)
local CarService = require(script.Parent.CarService)
local Traffic = require(script.Parent.Traffic)
local Lanes = require(script.Parent.Lanes)

local Police = {}

local P = Config.Police
local MAX_TOTAL_UNITS = 14
local TICK = 0.2

type Unit = {
	model: Model,
	chassis: BasePart,
	physics: any,
	kind: string,
	normalStats: CarStats.Stats,
	boostStats: CarStats.Stats,
	boosted: boolean,
	stuck: number,
	reverse: number,
	reverseSteer: number,
}

type Pursuit = {
	player: Player,
	heat: number,
	status: string, -- "PullOver" | "Pursuit"
	units: { Unit },
	timer: number, -- pull-over countdown
	stopTimer: number,
	bustTimer: number,
	escapeTimer: number,
	heatTimer: number,
	spawnTimer: number,
	roadblockTimer: number,
	spikeTimer: number,
	ticket: number,
	reasons: { string },
	heli: Model?,
	props: { Instance },
}

type Watch = {
	lastSign: number,
	flips: { number },
	cooldowns: { [string]: number },
}

local pursuits: { [Player]: Pursuit } = {}
local watches: { [Player]: Watch } = {}
local policeFolder: Folder
local mapParams = RaycastParams.new()

local function notify(player: Player, text: string, kind: string?)
	Remotes.event("Notify"):FireClient(player, text, kind or "police")
end

----------------------------------------------------------------------
-- Target helpers
----------------------------------------------------------------------
local function targetOf(player: Player): (Vector3?, Vector3, Vector3, boolean)
	local car = CarService.getDrivenCar(player)
	if car then
		local chassis = car:FindFirstChild("Chassis") :: BasePart?
		if chassis then
			return chassis.Position, chassis.AssemblyLinearVelocity, chassis.CFrame.LookVector, true
		end
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		return root.Position, root.AssemblyLinearVelocity, root.CFrame.LookVector, false
	end
	return nil, Vector3.zero, Vector3.zAxis, false
end

local function totalUnits(): number
	local n = 0
	for _, p in pursuits do
		n += #p.units
	end
	return n
end

local function nearestUnitDistance(p: Pursuit, pos: Vector3): number
	local best = math.huge
	for _, u in p.units do
		local d = (u.chassis.Position - pos).Magnitude
		if d < best then
			best = d
		end
	end
	return best
end

----------------------------------------------------------------------
-- Units
----------------------------------------------------------------------
local function spawnUnit(p: Pursuit, kind: string, groundCf: CFrame): Unit?
	if totalUnits() >= MAX_TOTAL_UNITS then
		return nil
	end
	local spec = P.Units[kind]
	local heatScale = 1 + 0.05 * (p.heat - 1)
	local stats = CarStats.fromUnit(spec, heatScale)
	local boost = CarStats.fromUnit(spec, heatScale * 1.35)
	local model = CarFactory.build(spec.Geometry, {
		Kind = "Police",
		RideHeight = stats.RideHeight,
		WheelRadius = stats.WheelRadius,
		Suv = kind == "SUV",
		Name = "Police_" .. kind,
	})
	local seat = model:FindFirstChild("DriverSeat")
	if seat then
		seat:Destroy()
	end
	model:SetAttribute("Sirens", true)
	model:SetAttribute("Target", p.player.UserId)
	CarFactory.place(model, groundCf + Vector3.new(0, 0.3, 0))
	model.Parent = policeFolder
	local chassis = model:FindFirstChild("Chassis") :: BasePart
	chassis.Anchored = false
	pcall(function()
		chassis:SetNetworkOwner(nil)
	end)
	chassis.AssemblyLinearVelocity = groundCf.LookVector * 40
	local unit: Unit = {
		model = model,
		chassis = chassis,
		physics = CarPhysics.new(model, stats, false),
		kind = kind,
		normalStats = stats,
		boostStats = boost,
		boosted = false,
		stuck = 0,
		reverse = 0,
		reverseSteer = 0,
	}
	table.insert(p.units, unit)
	return unit
end

local function unitKindFor(heat: number): string
	local mix = P.UnitMix[math.clamp(math.floor(heat), 1, #P.UnitMix)]
	return mix[math.random(1, #mix)]
end

local function spawnNear(p: Pursuit)
	local pos, vel = targetOf(p.player)
	if not pos then
		return
	end
	local cf = Lanes.findSpawn(pos, 220, 520, vel)
	if cf then
		spawnUnit(p, unitKindFor(p.heat), cf + Vector3.new(0, 0.2, 0))
	end
end

local function destroyUnit(p: Pursuit, unit: Unit)
	local i = table.find(p.units, unit)
	if i then
		table.remove(p.units, i)
	end
	unit.model:Destroy()
end

----------------------------------------------------------------------
-- Helicopter, roadblocks, spikes
----------------------------------------------------------------------
local function buildHeli(pos: Vector3): Model
	local m = Instance.new("Model")
	m.Name = "PoliceHelicopter"
	local function part(size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?): Part
		local x = Instance.new("Part")
		x.Size = size
		x.CFrame = cf
		x.Color = color
		x.Material = mat or Enum.Material.SmoothPlastic
		x.Anchored = true
		x.CanCollide = false
		x.CanQuery = false
		x.Parent = m
		return x
	end
	local body = part(Vector3.new(8, 7, 16), CFrame.new(pos), Color3.fromRGB(20, 30, 70))
	m.PrimaryPart = body
	part(Vector3.new(7.6, 4, 5), CFrame.new(pos + Vector3.new(0, 0.5, -8.5)), Color3.fromRGB(30, 40, 60), Enum.Material.Glass)
	part(Vector3.new(1.5, 1.5, 16), CFrame.new(pos + Vector3.new(0, 1.5, 15)), Color3.fromRGB(20, 30, 70))
	part(Vector3.new(0.4, 0.3, 40), CFrame.new(pos + Vector3.new(0, 4.2, 0)), Color3.fromRGB(30, 30, 30))
	part(Vector3.new(40, 0.3, 0.4), CFrame.new(pos + Vector3.new(0, 4.2, 0)), Color3.fromRGB(30, 30, 30))
	local lamp = part(Vector3.new(1.5, 1, 1.5), CFrame.new(pos + Vector3.new(0, -3.8, -5)) * CFrame.Angles(-math.pi / 2, 0, 0), Color3.fromRGB(255, 255, 230), Enum.Material.Neon)
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Front
	spot.Range = 220
	spot.Angle = 30
	spot.Brightness = 8
	spot.Parent = lamp
	for _, side in { -1, 1 } do
		local l = part(Vector3.new(1, 0.6, 1), CFrame.new(pos + Vector3.new(side * 4.1, -2, 0)), if side < 0 then Color3.fromRGB(255, 20, 20) else Color3.fromRGB(20, 60, 255), Enum.Material.Neon)
		l.Name = "Lightbar"
		l:SetAttribute("LightColor", l.Color)
		game:GetService("CollectionService"):AddTag(l, "Lightbar")
	end
	m:SetAttribute("Sirens", true)
	m.Parent = policeFolder
	return m
end

local function closestLanePoint(pos: Vector3): (CFrame?, number)
	local bestCf, bestD = nil, math.huge
	for _, lane in Lanes.all() do
		local s, d = Lanes.closest(lane, pos)
		if d < bestD then
			local p, dir = Lanes.sample(lane, s)
			bestCf, bestD = CFrame.lookAt(p, p + dir), d
		end
	end
	return bestCf, bestD
end

local function spawnRoadblock(p: Pursuit)
	local pos, vel = targetOf(p.player)
	if not pos or vel.Magnitude < 30 then
		return
	end
	local ahead = pos + Vector3.new(vel.X, 0, vel.Z).Unit * 420
	local cf, d = closestLanePoint(ahead)
	if not cf or d > 40 then
		return
	end
	local ground = CFrame.new(cf.Position.X, 0.2, cf.Position.Z) * cf.Rotation
	local folder = Instance.new("Folder")
	folder.Name = "Roadblock"
	for _, offset in { -9, 9 } do
		local car = CarFactory.build("Rally", { Kind = "Police", RideHeight = 1.1, WheelRadius = 1.25, Name = "RoadblockCar" })
		local seat = car:FindFirstChild("DriverSeat")
		if seat then
			seat:Destroy()
		end
		car:SetAttribute("Sirens", true)
		CarFactory.place(car, ground * CFrame.new(offset, 0, 0) * CFrame.Angles(0, math.rad(80 * math.sign(offset)), 0))
		local chassis = car:FindFirstChild("Chassis") :: BasePart
		chassis.Anchored = true
		car.Parent = folder
	end
	for _, offset in { -24, 24 } do
		local b = Instance.new("Part")
		b.Size = Vector3.new(14, 3, 1)
		b.CFrame = ground * CFrame.new(offset, 1.7, -6)
		b.Color = Color3.fromRGB(255, 120, 0)
		b.Material = Enum.Material.SmoothPlastic
		b.Anchored = true
		b.Parent = folder
	end
	folder.Parent = policeFolder
	table.insert(p.props, folder)
	notify(p.player, "Roadblock ahead!", "police")
	task.delay(40, function()
		folder:Destroy()
	end)
end

local function spawnSpikes(p: Pursuit)
	local pos, vel = targetOf(p.player)
	if not pos or vel.Magnitude < 40 then
		return
	end
	local ahead = pos + Vector3.new(vel.X, 0, vel.Z).Unit * 260
	local cf, d = closestLanePoint(ahead)
	if not cf or d > 40 then
		return
	end
	local ground = CFrame.new(cf.Position.X, 0.2, cf.Position.Z) * cf.Rotation
	local folder = Instance.new("Folder")
	folder.Name = "SpikeStrip"
	local strip = Instance.new("Part")
	strip.Size = Vector3.new(30, 0.25, 1.4)
	strip.CFrame = ground * CFrame.new(0, 0.15, 0)
	strip.Color = Color3.fromRGB(40, 40, 40)
	strip.Material = Enum.Material.DiamondPlate
	strip.Anchored = true
	strip.CanCollide = false
	strip.Parent = folder
	local trigger = Instance.new("Part")
	trigger.Size = Vector3.new(30, 8, 4)
	trigger.CFrame = ground * CFrame.new(0, 4, 0)
	trigger.Transparency = 1
	trigger.Anchored = true
	trigger.CanCollide = false
	trigger.CanQuery = false
	trigger.Parent = folder
	trigger.Touched:Connect(function(hit)
		local car = hit.Parent
		if car and car:IsA("Model") and car:GetAttribute("Kind") == "Player" and not car:GetAttribute("TiresPopped") then
			car:SetAttribute("TiresPopped", true)
			local owner = Players:GetPlayerByUserId(car:GetAttribute("Owner") :: number)
			if owner then
				notify(owner, "SPIKE STRIP! Your tyres are shredded for 20 seconds.", "warn")
			end
			task.delay(20, function()
				if car.Parent then
					car:SetAttribute("TiresPopped", nil)
				end
			end)
		end
	end)
	folder.Parent = policeFolder
	table.insert(p.props, folder)
	task.delay(30, function()
		folder:Destroy()
	end)
end

----------------------------------------------------------------------
-- Pursuit lifecycle
----------------------------------------------------------------------
local function setAttrs(p: Pursuit?, player: Player)
	if not p then
		player:SetAttribute("Heat", 0)
		player:SetAttribute("PoliceStatus", "")
		player:SetAttribute("BustProgress", 0)
		player:SetAttribute("EscapeProgress", 0)
		player:SetAttribute("PullOverTime", 0)
		return
	end
	player:SetAttribute("Heat", math.floor(p.heat))
	player:SetAttribute("PoliceStatus", p.status)
	player:SetAttribute("BustProgress", math.clamp(p.bustTimer / P.BustTime, 0, 1))
	player:SetAttribute("EscapeProgress", math.clamp(p.escapeTimer / P.EscapeTime, 0, 1))
	player:SetAttribute("PullOverTime", if p.status == "PullOver" then math.max(0, p.timer) else 0)
end

local function endPursuit(player: Player)
	local p = pursuits[player]
	if not p then
		return
	end
	pursuits[player] = nil
	for _, u in table.clone(p.units) do
		destroyUnit(p, u)
	end
	if p.heli then
		p.heli:Destroy()
	end
	for _, prop in p.props do
		prop:Destroy()
	end
	setAttrs(nil, player)
end

local function startPursuit(player: Player, fromPatrol: any?)
	local p: Pursuit = {
		player = player,
		heat = 1,
		status = "PullOver",
		units = {},
		timer = P.PullOverTime,
		stopTimer = 0,
		bustTimer = 0,
		escapeTimer = 0,
		heatTimer = 0,
		spawnTimer = 0,
		roadblockTimer = 15,
		spikeTimer = 20,
		ticket = 0,
		reasons = {},
		heli = nil,
		props = {},
	}
	pursuits[player] = p
	if fromPatrol then
		local cf = Traffic.takePatrol(fromPatrol)
		local ground = CFrame.new(cf.Position.X, 0.2, cf.Position.Z) * cf.Rotation
		spawnUnit(p, "Cruiser", ground)
	else
		spawnNear(p)
	end
	return p
end

local function escalate(p: Pursuit, amount: number)
	if p.status == "PullOver" then
		p.status = "Pursuit"
		p.heat = math.max(p.heat, 2)
		notify(p.player, "You're evading the police! Lose them or get busted.", "police")
	else
		local before = math.floor(p.heat)
		p.heat = math.min(P.MaxHeat, p.heat + amount)
		if math.floor(p.heat) > before then
			notify(p.player, string.format("Heat level %d!", math.floor(p.heat)), "police")
		end
	end
end

local function bust(player: Player)
	local p = pursuits[player]
	if not p then
		return
	end
	local fine = math.floor(P.BustFinePerHeat * math.max(1, p.heat) + p.ticket)
	local profile = PlayerData.get(player)
	if profile then
		fine = math.min(fine, profile.Cash)
	end
	endPursuit(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.SeatPart then
		CarService.exitSeat(hum)
	end
	CarService.despawn(player)
	task.defer(function()
		if player.Character then
			player.Character:PivotTo(MapBuilder.Layout.PoliceStation)
		end
	end)
	PlayerData.addCash(player, -fine, "BUSTED - fine & impound")
	PlayerData.bumpStat(player, "Busts", 1)
	Remotes.event("Notify"):FireClient(player, "BUSTED! Your car was impounded. Respawn it from the HUD.", "bust")
end

local function escape(player: Player)
	local p = pursuits[player]
	if not p then
		return
	end
	local heat = p.heat
	endPursuit(player)
	if heat >= 2 then
		PlayerData.addCash(player, math.floor(P.EscapeRewardPerHeat * heat), "Escaped the police!")
		PlayerData.bumpStat(player, "Escapes", 1)
	else
		notify(player, "The police lost interest.", "info")
	end
end

local function ticketAndRelease(player: Player)
	local p = pursuits[player]
	if not p then
		return
	end
	local fine = math.floor(p.ticket)
	local profile = PlayerData.get(player)
	if profile then
		fine = math.min(fine, profile.Cash)
	end
	local reasons = table.concat(p.reasons, ", ")
	endPursuit(player)
	PlayerData.addCash(player, -fine, "Ticket: " .. reasons)
	PlayerData.bumpStat(player, "Tickets", 1)
end

----------------------------------------------------------------------
-- Violations
----------------------------------------------------------------------
local function findWitness(pos: Vector3, allowCamera: boolean): (boolean, any?)
	for _, patrol in Traffic.getPatrols() do
		if (patrol.chassis.Position - pos).Magnitude < P.WitnessRange then
			return true, patrol
		end
	end
	for _, p in pursuits do
		if nearestUnitDistance(p, pos) < 400 then
			return true, nil
		end
	end
	if allowCamera then
		for _, cam in MapBuilder.Layout.SpeedCameras do
			if (cam.Position - pos).Magnitude < P.CameraRange then
				local flash = cam.Flash
				flash.Material = Enum.Material.Neon
				flash.Color = Color3.new(1, 1, 1)
				task.delay(0.3, function()
					flash.Material = Enum.Material.SmoothPlastic
					flash.Color = Color3.fromRGB(80, 80, 80)
				end)
				return true, "camera"
			end
		end
	end
	return false, nil
end

function Police.reportViolation(player: Player, kind: string, detail: string, fine: number, witness: any?)
	local w = watches[player]
	if not w then
		return
	end
	local now = os.clock()
	if w.cooldowns[kind] and now - w.cooldowns[kind] < 8 then
		return
	end
	w.cooldowns[kind] = now

	local p = pursuits[player]
	if not p then
		if witness == "camera" then
			-- cameras mail you a ticket and alert nearby units
			local profile = PlayerData.get(player)
			if profile then
				PlayerData.addCash(player, -math.min(fine, profile.Cash), "Speed camera: " .. detail)
			end
			Remotes.event("CameraFlash"):FireClient(player)
			if math.random() < 0.5 then
				p = startPursuit(player, nil)
				p.ticket += fine * 0.5
				table.insert(p.reasons, detail)
				notify(player, "A unit responded to the camera. PULL OVER!", "police")
			end
			return
		end
		p = startPursuit(player, if typeof(witness) == "table" then witness else nil)
		p.ticket += fine
		table.insert(p.reasons, detail)
		notify(player, "Police: PULL OVER! (" .. detail .. ")", "police")
		if kind == "HitPolice" then
			escalate(p, 1)
		end
		return
	end
	p.ticket += fine
	if not table.find(p.reasons, detail) then
		table.insert(p.reasons, detail)
	end
	escalate(p, if kind == "HitPolice" then 1 else 0.5)
end

local function monitor(player: Player, dt: number)
	local car = CarService.getDrivenCar(player)
	local w = watches[player]
	if not car or not w then
		return
	end
	local chassis = car:FindFirstChild("Chassis") :: BasePart?
	if not chassis then
		return
	end
	local pos = chassis.Position
	local zone = MapBuilder.getZone(pos)
	local limit = Config.SpeedLimits[zone] or 55
	player:SetAttribute("Zone", zone)
	player:SetAttribute("SpeedLimit", if limit == math.huge then 0 else limit)
	local vel = chassis.AssemblyLinearVelocity
	local mph = Vector3.new(vel.X, 0, vel.Z).Magnitude * Config.STUDS_TO_MPH
	if zone == "Track" then
		return
	end

	if mph > limit + P.SpeedingTolerance then
		local seen, witness = findWitness(pos, true)
		if seen then
			local over = math.floor(mph - limit)
			Police.reportViolation(player, "Speeding", string.format("Speeding %d over", over), P.TicketBase + P.TicketPerMph * over, witness)
		end
	end

	-- swerving: rapid left/right yaw reversals at speed
	local yaw = chassis.AssemblyAngularVelocity.Y
	local now = os.clock()
	if mph > 35 and math.abs(yaw) > 0.8 then
		local s = math.sign(yaw)
		if s ~= w.lastSign then
			w.lastSign = s
			table.insert(w.flips, now)
		end
	end
	while #w.flips > 0 and now - w.flips[1] > 4 do
		table.remove(w.flips, 1)
	end
	if #w.flips >= 4 then
		w.flips = {}
		local seen, witness = findWitness(pos, false)
		if seen then
			Police.reportViolation(player, "Swerving", "Swerving / reckless lane changes", 300, witness)
		end
	end
end

----------------------------------------------------------------------
-- Unit AI (runs every physics step)
----------------------------------------------------------------------
local function driveUnit(p: Pursuit, u: Unit, dt: number, tpos: Vector3, tvel: Vector3, tlook: Vector3)
	local chassis = u.chassis
	local cf = chassis.CFrame
	local speed = chassis.AssemblyLinearVelocity.Magnitude
	local toT = tpos - cf.Position
	local dist = toT.Magnitude
	local aim = tpos + tvel * math.clamp(dist / 140, 0, 1.2)
	if p.status == "PullOver" then
		aim = tpos - Vector3.new(tlook.X, 0, tlook.Z).Unit * 22
	end
	local dir = aim - cf.Position
	local localDir = cf:VectorToObjectSpace(Vector3.new(dir.X, 0, dir.Z))
	local angle = math.atan2(localDir.X, -localDir.Z)
	local steer = math.clamp(angle * 2.2, -1, 1)
	local throttle = 1

	if p.status == "PullOver" and dist < 45 then
		local targetSpeed = tvel.Magnitude
		throttle = math.clamp((targetSpeed - speed) * 0.08 + (dist - 22) * 0.02, -1, 1)
	end
	if math.abs(angle) > 2.3 and dist < 70 then
		throttle = -1
		steer = -math.sign(angle)
	end

	-- avoid walls and buildings
	if speed > 10 then
		local look = cf.LookVector
		local probe = 25 + speed * 0.45
		local hit = workspace:Raycast(cf.Position, look * probe, mapParams)
		if hit and hit.Distance < dist then
			local left = workspace:Raycast(cf.Position, (cf * CFrame.Angles(0, math.rad(35), 0)).LookVector * probe, mapParams)
			local right = workspace:Raycast(cf.Position, (cf * CFrame.Angles(0, math.rad(-35), 0)).LookVector * probe, mapParams)
			local ld = if left then left.Distance else probe
			local rd = if right then right.Distance else probe
			steer = if ld > rd then -1 else 1
			if hit.Distance < 20 then
				throttle = math.min(throttle, -0.5)
			end
		end
	end

	-- stuck: back up
	if u.reverse > 0 then
		u.reverse -= dt
		throttle = -1
		steer = u.reverseSteer
	elseif throttle > 0.5 and speed < 4 then
		u.stuck += dt
		if u.stuck > 2 then
			u.stuck = 0
			u.reverse = 1.4
			u.reverseSteer = -steer
		end
	else
		u.stuck = 0
	end

	-- rubber-band when far behind
	local wantBoost = dist > 300 and p.status == "Pursuit"
	if wantBoost ~= u.boosted then
		u.boosted = wantBoost
		u.physics:setStats(if wantBoost then u.boostStats else u.normalStats)
	end

	u.physics:step(dt, { throttle = throttle, steer = steer, handbrake = math.abs(angle) > 1.2 and speed > 60, nitro = false })
end

local function updatePursuit(p: Pursuit, dt: number)
	local player = p.player
	local pos, vel, _, inCar = targetOf(player)
	if not pos then
		return
	end
	local nearest = nearestUnitDistance(p, pos)
	local speed = vel.Magnitude

	-- remove units that are hopelessly far or destroyed; replace them
	for _, u in table.clone(p.units) do
		if not u.chassis.Parent or (u.chassis.Position - pos).Magnitude > 1600 or u.chassis.Position.Y < -50 then
			destroyUnit(p, u)
		end
	end

	if p.status == "PullOver" then
		if #p.units == 0 then
			spawnNear(p)
		end
		if speed < 4 and nearest < 70 then
			p.stopTimer += dt
			if p.stopTimer >= P.StopToTicketTime then
				ticketAndRelease(player)
				return
			end
		else
			p.stopTimer = 0
			p.timer -= dt
			if p.timer <= 0 then
				escalate(p, 0)
			end
		end
	else
		p.heatTimer += dt
		if p.heatTimer >= P.HeatGainInterval then
			p.heatTimer = 0
			escalate(p, 1)
		end
		local want = P.UnitsPerHeat[math.clamp(math.floor(p.heat), 1, #P.UnitsPerHeat)]
		p.spawnTimer -= dt
		if #p.units < want and p.spawnTimer <= 0 then
			p.spawnTimer = 3
			spawnNear(p)
		end

		-- bust
		local bustRange = if inCar then P.BustRange else 25
		if nearest < bustRange and (speed < 6 or not inCar) then
			p.bustTimer += dt * (if inCar then 1 else 1.5)
			if p.bustTimer >= P.BustTime then
				bust(player)
				return
			end
		else
			p.bustTimer = math.max(0, p.bustTimer - dt * 0.5)
		end

		-- escape
		local heliSees = false
		if p.heli and p.heli.PrimaryPart then
			local hp = p.heli.PrimaryPart.Position
			heliSees = (Vector3.new(hp.X, 0, hp.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude < 350
		end
		if nearest > P.EscapeRange and not heliSees then
			p.escapeTimer += dt
			if p.escapeTimer >= P.EscapeTime then
				escape(player)
				return
			end
		else
			p.escapeTimer = math.max(0, p.escapeTimer - dt * 2)
		end

		-- tactics
		if p.heat >= P.RoadblockHeat then
			p.roadblockTimer -= dt
			if p.roadblockTimer <= 0 then
				p.roadblockTimer = 35
				spawnRoadblock(p)
			end
		end
		if p.heat >= P.SpikeHeat then
			p.spikeTimer -= dt
			if p.spikeTimer <= 0 then
				p.spikeTimer = 28
				spawnSpikes(p)
			end
		end
		if p.heat >= P.HelicopterHeat and not p.heli then
			p.heli = buildHeli(pos + Vector3.new(0, 150, 200))
			notify(player, "Police helicopter inbound!", "police")
		end
	end
	setAttrs(p, player)
end

local function updateHeli(p: Pursuit, dt: number)
	local heli = p.heli
	if not heli or not heli.PrimaryPart then
		return
	end
	local pos, vel = targetOf(p.player)
	if not pos then
		return
	end
	local current = heli:GetPivot()
	local goal = pos + Vector3.new(vel.X, 0, vel.Z) * 0.8 + Vector3.new(0, 150, 0)
	local delta = goal - current.Position
	local maxStep = 150 * dt
	local step = if delta.Magnitude > maxStep then delta.Unit * maxStep else delta
	local newPos = current.Position + step
	local flatTo = Vector3.new(pos.X - newPos.X, 0, pos.Z - newPos.Z)
	local look = if flatTo.Magnitude > 1 then flatTo.Unit else current.LookVector
	heli:PivotTo(CFrame.lookAt(newPos, newPos + look) * CFrame.Angles(math.rad(-8), 0, 0))
end

function Police.getHeat(player: Player): number
	local p = pursuits[player]
	return if p then p.heat else 0
end

function Police.init()
	local vehicles = workspace:WaitForChild("Vehicles")
	policeFolder = Instance.new("Folder")
	policeFolder.Name = "Police"
	policeFolder.Parent = vehicles
	mapParams.FilterType = Enum.RaycastFilterType.Include
	mapParams.FilterDescendantsInstances = { workspace:WaitForChild("Map") }

	Traffic.OnPlayerCollision = function(player: Player, kind: string, pos: Vector3)
		if kind == "HitPolice" then
			Police.reportViolation(player, "HitPolice", "Hitting a police car", 800, nil)
		else
			local seen, witness = findWitness(pos, false)
			if seen then
				Police.reportViolation(player, "Reckless", "Reckless driving (collision)", 400, witness)
			end
		end
	end
end

function Police.start()
	local function onAdded(player: Player)
		watches[player] = { lastSign = 0, flips = {}, cooldowns = {} }
		setAttrs(nil, player)
		player.CharacterAdded:Connect(function(char)
			local hum = char:WaitForChild("Humanoid") :: Humanoid
			hum.Died:Connect(function()
				endPursuit(player)
			end)
		end)
	end
	Players.PlayerAdded:Connect(onAdded)
	for _, player in Players:GetPlayers() do
		onAdded(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		endPursuit(player)
		watches[player] = nil
	end)

	RunService.Stepped:Connect(function(_, dt)
		for _, p in pursuits do
			local pos, vel, look = targetOf(p.player)
			if pos then
				for _, u in p.units do
					if u.chassis.Parent then
						driveUnit(p, u, dt, pos, vel, look)
					end
				end
			end
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		for _, p in pursuits do
			updateHeli(p, dt)
		end
	end)

	while true do
		local dt = task.wait(TICK)
		for _, player in Players:GetPlayers() do
			monitor(player, dt)
			local p = pursuits[player]
			if p then
				updatePursuit(p, dt)
			end
		end
	end
end

return Police
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">Racing</string><ProtectedString name="Source"><![CDATA[--!strict
-- Quarter-mile and half-mile drag strips. Roll into a lane's staging box and
-- sit still to stage; a second racer has a few seconds to stage in the other
-- lane. Then the christmas tree counts down (3 ambers, green). Leaving early
-- is a red light. Elapsed time (ET), reaction time and trap speed are
-- measured on the server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)
local MapBuilder = require(script.Parent.MapBuilder)

local Racing = {}

local R = Config.Racing
local OFF = Color3.fromRGB(35, 35, 35)
local TIMEOUT = 45

type Racer = {
	player: Player,
	car: Model,
	chassis: BasePart,
	laneIndex: number,
	lastX: number,
	reaction: number?,
	et: number?,
	trap: number?,
	result: string?, -- nil while running, else "Finished" | "Red light" | "DQ" | "DNF"
}

type StripState = {
	strip: MapBuilder.Strip,
	status: string, -- Idle | Staging | Countdown | Racing | Cooldown
	stageTimers: { number },
	stagedBy: { Player? },
	timer: number,
	treeStep: number,
	greenAt: number,
	racers: { Racer },
	record: { name: string, et: number }?,
}

local states: { StripState } = {}

local function light(part: BasePart, on: boolean)
	if on then
		part.Color = part:GetAttribute("OnColor") :: Color3
		part.Material = Enum.Material.Neon
	else
		part.Color = OFF
		part.Material = Enum.Material.SmoothPlastic
	end
end

local function resetTree(st: StripState)
	for _, lane in st.strip.Lanes do
		local t = lane.Tree
		light(t.Stage, false)
		light(t.Green, false)
		light(t.Red, false)
		for _, a in t.Amber do
			light(a, false)
		end
	end
end

local function fire(st: StripState, payload: { [string]: any })
	payload.strip = st.strip.Name
	for _, r in st.racers do
		Remotes.event("RaceUpdate"):FireClient(r.player, payload)
	end
end

-- Player car currently driven by someone and sitting in the given lane's staging box
local function carInStage(st: StripState, laneIndex: number): (Player?, Model?, BasePart?)
	local lane = st.strip.Lanes[laneIndex]
	local vehicles = workspace:FindFirstChild("Vehicles")
	local folder = vehicles and vehicles:FindFirstChild("Players")
	if not folder then
		return nil, nil, nil
	end
	for _, car in folder:GetChildren() do
		if not car:IsA("Model") then
			continue
		end
		local driverId = car:GetAttribute("Driver") :: number?
		local chassis = car:FindFirstChild("Chassis") :: BasePart?
		if driverId and chassis then
			local p = chassis.Position
			if p.X > st.strip.StartX - 18 and p.X < st.strip.StartX - 1 and math.abs(p.Z - lane.Z) < 7 then
				return Players:GetPlayerByUserId(driverId), car, chassis
			end
		end
	end
	return nil, nil, nil
end

local function boardText(st: StripState): string
	local lines = { string.upper(st.strip.Name) .. " MILE" }
	for i, r in st.racers do
		local laneName = if r.laneIndex == 1 then "L" else "R"
		if r.et then
			table.insert(lines, string.format("%s %s  %.3fs @ %d MPH", laneName, r.player.DisplayName, r.et, math.floor(r.trap or 0)))
		else
			table.insert(lines, string.format("%s %s  %s", laneName, r.player.DisplayName, r.result or "--"))
		end
		if i >= 2 then
			break
		end
	end
	if st.record then
		table.insert(lines, string.format("RECORD %.3fs %s", st.record.et, st.record.name))
	end
	return table.concat(lines, "\n")
end

local function finishRace(st: StripState)
	local payout = R.Payout[st.strip.Name]
	local finishers = {}
	for _, r in st.racers do
		if r.result == "Finished" and r.et then
			table.insert(finishers, r)
		end
	end
	table.sort(finishers, function(a, b)
		return (a.et :: number) < (b.et :: number)
	end)
	for _, r in st.racers do
		local place = table.find(finishers, r)
		local cash = 0
		local isPb = false
		if r.result == "Finished" and r.et then
			cash = payout.Base
			if place == 1 and #st.racers > 1 then
				cash += payout.WinBonus
				PlayerData.bumpStat(r.player, "Wins", 1)
			end
			local profile = PlayerData.get(r.player)
			if profile then
				local best = profile.Best[st.strip.Name]
				if not best or r.et < best then
					profile.Best[st.strip.Name] = r.et
					isPb = true
				end
			end
			if not st.record or r.et < st.record.et then
				st.record = { name = r.player.DisplayName, et = r.et }
				cash += R.RecordBonus
			end
		end
		PlayerData.bumpStat(r.player, "Races", 1)
		if cash > 0 then
			PlayerData.addCash(r.player, cash, st.strip.Name .. " mile run")
		end
		Remotes.event("RaceUpdate"):FireClient(r.player, {
			type = "Result",
			strip = st.strip.Name,
			result = r.result,
			et = r.et,
			trap = r.trap,
			reaction = r.reaction,
			place = place,
			racers = #st.racers,
			pb = isPb,
			payout = cash,
		})
	end
	st.strip.Board.Text = boardText(st)
	st.status = "Cooldown"
	st.timer = 4
end

local function updateStrip(st: StripState, dt: number)
	local strip = st.strip
	if st.status == "Idle" or st.status == "Staging" then
		for i = 1, 2 do
			local player, car, chassis = carInStage(st, i)
			local tree = strip.Lanes[i].Tree
			if player and car and chassis and chassis.AssemblyLinearVelocity.Magnitude < 3 then
				st.stageTimers[i] += dt
				if st.stageTimers[i] >= R.StageHoldTime and st.stagedBy[i] ~= player then
					st.stagedBy[i] = player
					light(tree.Stage, true)
					Remotes.event("RaceUpdate"):FireClient(player, { type = "Staged", strip = strip.Name })
					if st.status == "Idle" then
						st.status = "Staging"
						st.timer = R.OpponentWait
					end
				end
			elseif not player then
				st.stageTimers[i] = 0
				if st.stagedBy[i] then
					st.stagedBy[i] = nil
					light(tree.Stage, false)
				end
			end
		end
		if st.status == "Staging" then
			st.timer -= dt
			local both = st.stagedBy[1] and st.stagedBy[2]
			local any = st.stagedBy[1] or st.stagedBy[2]
			if not any then
				st.status = "Idle"
			elseif both or st.timer <= 0 then
				-- lock in racers and start the tree
				st.racers = {}
				for i = 1, 2 do
					local player, car, chassis = carInStage(st, i)
					if player and car and chassis and st.stagedBy[i] == player then
						table.insert(st.racers, {
							player = player,
							car = car,
							chassis = chassis,
							laneIndex = i,
							lastX = chassis.Position.X,
						})
					end
				end
				if #st.racers == 0 then
					st.status = "Idle"
					resetTree(st)
					return
				end
				st.status = "Countdown"
				st.timer = 0
				st.treeStep = 0
			end
		end
	elseif st.status == "Countdown" then
		st.timer += dt
		local step = math.floor(st.timer / R.AmberInterval) + 1
		if step > st.treeStep then
			st.treeStep = step
			for _, r in st.racers do
				local tree = strip.Lanes[r.laneIndex].Tree
				if step <= 3 then
					light(tree.Amber[step], true)
				end
			end
			if step >= 4 then
				st.greenAt = os.clock()
				st.status = "Racing"
				for _, r in st.racers do
					local tree = strip.Lanes[r.laneIndex].Tree
					for _, a in tree.Amber do
						light(a, false)
					end
					if not r.result then
						light(tree.Green, true)
					end
				end
				fire(st, { type = "Tree", step = 4 })
				return
			end
			fire(st, { type = "Tree", step = step })
		end
		-- red light: moving past the start line before green
		for _, r in st.racers do
			if not r.result and r.chassis.Position.X > strip.StartX then
				r.result = "Red light"
				light(strip.Lanes[r.laneIndex].Tree.Red, true)
			end
		end
	elseif st.status == "Racing" then
		local now = os.clock()
		local running = 0
		for _, r in st.racers do
			if r.result then
				continue
			end
			local chassis = r.chassis
			if not chassis.Parent or r.car:GetAttribute("Driver") ~= r.player.UserId then
				r.result = "DNF"
				continue
			end
			local x = chassis.Position.X
			local lane = strip.Lanes[r.laneIndex]
			if math.abs(chassis.Position.Z - lane.Z) > 12 then
				r.result = "DQ"
				continue
			end
			if not r.reaction and x > strip.StartX - 1 then
				r.reaction = now - st.greenAt
			end
			if x >= strip.FinishX then
				-- interpolate the crossing within this frame
				local frac = if x > r.lastX then (strip.FinishX - r.lastX) / (x - r.lastX) else 1
				r.et = (now - dt * (1 - frac)) - st.greenAt
				r.trap = chassis.AssemblyLinearVelocity.Magnitude * Config.STUDS_TO_MPH
				r.result = "Finished"
				continue
			end
			r.lastX = x
			running += 1
		end
		if running == 0 or now - st.greenAt > TIMEOUT then
			for _, r in st.racers do
				r.result = r.result or "DNF"
			end
			finishRace(st)
		end
	elseif st.status == "Cooldown" then
		st.timer -= dt
		if st.timer <= 0 then
			st.status = "Idle"
			st.racers = {}
			st.stagedBy = {}
			st.stageTimers = { 0, 0 }
			resetTree(st)
		end
	end
end

function Racing.init() end

function Racing.start()
	for _, strip in MapBuilder.Layout.Strips do
		local st: StripState = {
			strip = strip,
			status = "Idle",
			stageTimers = { 0, 0 },
			stagedBy = {},
			timer = 0,
			treeStep = 0,
			greenAt = 0,
			racers = {},
			record = nil,
		}
		resetTree(st)
		table.insert(states, st)
	end
	RunService.Heartbeat:Connect(function(dt)
		for _, st in states do
			updateStrip(st, dt)
		end
	end)
end

return Racing
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Traffic</string><ProtectedString name="Source"><![CDATA[--!strict
-- NPC traffic: kinematic (anchored) cars that follow lane loops on the
-- highway ring, the interstate and city streets. They brake for anything in
-- front of them and a few of them are police patrols that can witness
-- violations. Collisions with players are reported to the Police system.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local Lanes = require(script.Parent.Lanes)
local CarFactory = require(script.Parent.CarFactory)

local Traffic = {}

export type Npc = {
	model: Model,
	chassis: BasePart,
	lane: Lanes.Lane,
	s: number,
	speed: number,
	height: number,
	halfLen: number,
	isPolice: boolean,
	stuck: number,
	ghost: number,
	waited: number,
	lastHit: number,
}

local npcs: { Npc } = {}
local folder: Folder
local vehicles: Folder
local rayParams = RaycastParams.new()
local rng = Random.new()

local TRAFFIC_GEOMETRY = { "Hatch", "Coupe", "Pickup", "Muscle", "Rally" }
local ROAD_TOP = 0.2

-- Set by the Police system: (player, kind, position) -> ()
Traffic.OnPlayerCollision = nil :: ((Player, string, Vector3) -> ())?

local function randomCosmetics(): { [string]: string }
	local paint = Config.Paints[rng:NextInteger(1, #Config.Paints)].Name
	return { Paint = paint, Finish = "Gloss", Rims = "Silver", Underglow = "Off", Spoiler = "None", Tint = "Light" }
end

local function poseAt(npc: Npc): CFrame
	local p = Lanes.sample(npc.lane, npc.s)
	local ahead = Lanes.sample(npc.lane, npc.s + 14)
	local y = ROAD_TOP + npc.height
	local a = Vector3.new(p.X, y, p.Z)
	local b = Vector3.new(ahead.X, y, ahead.Z)
	if (b - a).Magnitude < 0.01 then
		return CFrame.new(a)
	end
	return CFrame.lookAt(a, b)
end

local function onTouched(npc: Npc, hit: BasePart)
	local now = os.clock()
	if now - npc.lastHit < 2 then
		return
	end
	-- every part of a player car is a direct child of its model
	local car = hit.Parent
	if not car or not car:IsA("Model") or car:GetAttribute("Kind") ~= "Player" then
		return
	end
	local driverId = car:GetAttribute("Driver") :: number?
	if not driverId then
		return
	end
	local player = Players:GetPlayerByUserId(driverId)
	local chassis = car:FindFirstChild("Chassis") :: BasePart?
	if not player or not chassis then
		return
	end
	local npcVel = npc.chassis.CFrame.LookVector * npc.speed
	local rel = (chassis.AssemblyLinearVelocity - npcVel).Magnitude
	if rel > 30 then
		npc.lastHit = now
		npc.speed = 0
		npc.stuck = 2
		if Traffic.OnPlayerCollision then
			Traffic.OnPlayerCollision(player, if npc.isPolice then "HitPolice" else "HitCar", npc.chassis.Position)
		end
	end
end

local function spawnNpc(lane: Lanes.Lane, s: number, isPolice: boolean): Npc
	local geometry = if isPolice then "Rally" else TRAFFIC_GEOMETRY[rng:NextInteger(1, #TRAFFIC_GEOMETRY)]
	local def = Config.Cars[geometry]
	local model = CarFactory.build(geometry, {
		Kind = if isPolice then "Police" else "Traffic",
		Cosmetics = randomCosmetics(),
		RideHeight = def.RideHeight,
		WheelRadius = def.WheelRadius,
		Name = if isPolice then "PolicePatrol" else "Traffic",
	})
	local chassis = model:FindFirstChild("Chassis") :: BasePart
	chassis.Anchored = true
	if isPolice then
		-- patrols are scenery until they start a pursuit; remove their seat
		local seat = model:FindFirstChild("DriverSeat")
		if seat then
			seat:Destroy()
		end
		model:SetAttribute("Patrol", true)
	end
	local npc: Npc = {
		model = model,
		chassis = chassis,
		lane = lane,
		s = s,
		speed = lane.Speed * rng:NextNumber(0.8, 1),
		height = model:GetAttribute("RestHeight") :: number,
		halfLen = def.Length / 2,
		isPolice = isPolice,
		stuck = 0,
		ghost = 0,
		waited = 0,
		lastHit = 0,
	}
	chassis.CFrame = poseAt(npc)
	model.Parent = folder
	chassis.Touched:Connect(function(hit)
		onTouched(npc, hit)
	end)
	table.insert(npcs, npc)
	return npc
end

function Traffic.getPatrols(): { Npc }
	local out = {}
	for _, npc in npcs do
		if npc.isPolice and npc.model.Parent then
			table.insert(out, npc)
		end
	end
	return out
end

-- Remove a patrol (it is replaced by a physics pursuit unit) and respawn it later
function Traffic.takePatrol(npc: Npc): CFrame
	local cf = npc.chassis.CFrame
	local idx = table.find(npcs, npc)
	if idx then
		table.remove(npcs, idx)
	end
	npc.model:Destroy()
	task.delay(60, function()
		spawnNpc(npc.lane, rng:NextNumber(0, npc.lane.Length), true)
	end)
	return cf
end

local function populate()
	local patrolBudget: { [string]: number } = {}
	for _, lane in Lanes.all() do
		local count = if lane.Kind == "Highway"
			then Config.Traffic.HighwayCarsPerLane
			elseif lane.Kind == "Interstate" then Config.Traffic.InterstateCarsPerLane
			else Config.Traffic.CityCarsPerLane
		local spacing = lane.Length / count
		patrolBudget[lane.Kind] = patrolBudget[lane.Kind] or Config.Police.PatrolsPerLaneGroup
		for i = 0, count - 1 do
			local isPolice = false
			if i == 0 and patrolBudget[lane.Kind] > 0 then
				patrolBudget[lane.Kind] -= 1
				isPolice = true
			end
			spawnNpc(lane, i * spacing + rng:NextNumber(0, spacing * 0.5), isPolice)
		end
	end
end

local function refreshFilter()
	local list: { Instance } = { vehicles }
	for _, plr in Players:GetPlayers() do
		if plr.Character then
			table.insert(list, plr.Character)
		end
	end
	rayParams.FilterDescendantsInstances = list
end

function Traffic.init()
	vehicles = workspace:FindFirstChild("Vehicles") :: Folder
	if not vehicles then
		vehicles = Instance.new("Folder")
		vehicles.Name = "Vehicles"
		vehicles.Parent = workspace
	end
	folder = Instance.new("Folder")
	folder.Name = "Traffic"
	folder.Parent = vehicles
	rayParams.FilterType = Enum.RaycastFilterType.Include
end

function Traffic.start()
	populate()
	refreshFilter()
	local filterTimer = 0
	local acc = 0
	local step = 1 / Config.Traffic.UpdateHz
	local range = Config.Traffic.ActiveRange

	RunService.Heartbeat:Connect(function(dt)
		filterTimer += dt
		if filterTimer > 2 then
			filterTimer = 0
			refreshFilter()
		end
		acc += dt
		if acc < step then
			return
		end
		local frameDt = acc
		acc = 0

		local playerPositions = {}
		for _, plr in Players:GetPlayers() do
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				table.insert(playerPositions, root.Position)
			end
		end

		for _, npc in npcs do
			local cf = npc.chassis.CFrame
			local near = false
			for _, p in playerPositions do
				if (p - cf.Position).Magnitude < range then
					near = true
					break
				end
			end

			local target = npc.lane.Speed
			if near then
				-- brake for anything ahead
				if npc.ghost > 0 then
					npc.ghost -= frameDt
				else
					local look = cf.LookVector
					local origin = cf.Position + look * (npc.halfLen + 1.5) + Vector3.new(0, -0.3, 0)
					local dist = 14 + npc.speed * 1.1
					local hit = workspace:Raycast(origin, look * dist, rayParams)
					if hit then
						local free = hit.Distance - 8
						target = if free <= 0 then 0 else math.min(target, npc.lane.Speed * free / dist)
					end
				end
			end
			if npc.stuck > 0 then
				npc.stuck -= frameDt
				target = 0
			end
			local accel = if target > npc.speed then 18 else 60
			npc.speed += math.clamp(target - npc.speed, -accel * frameDt, accel * frameDt)
			if npc.speed < 1 and target < 1 and npc.stuck <= 0 then
				-- after a long wait, ignore obstacles briefly to untangle jams
				npc.waited += frameDt
				if npc.waited > 4 then
					npc.ghost = 2.5
					npc.waited = 0
				end
			else
				npc.waited = 0
			end
			npc.s = (npc.s + npc.speed * frameDt) % npc.lane.Length
			if near then
				npc.chassis.CFrame = poseAt(npc)
			end
		end
	end)
end

return Traffic
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--!strict
-- Day/night cycle. Car headlights switch on automatically at night.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local World = {}

local isNight = false

local function nightNow(): boolean
	local t = Lighting.ClockTime
	return t < 6.4 or t > 17.9
end

local function applyLight(light: Instance)
	if light:IsA("Light") then
		light.Enabled = isNight
	end
end

function World.init() end

function World.start()
	CollectionService:GetInstanceAddedSignal("CarLight"):Connect(applyLight)
	local hoursPerSecond = 24 / (Config.DayLengthMinutes * 60)
	while true do
		local dt = task.wait(0.5)
		Lighting.ClockTime = (Lighting.ClockTime + dt * hoursPerSecond) % 24
		local night = nightNow()
		if night ~= isNight then
			isNight = night
			for _, light in CollectionService:GetTagged("CarLight") do
				applyLight(light)
			end
		end
	end
end

return World
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX29"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX28"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX27"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[--!strict
-- THE client entry point. Two-phase startup like the server.

local Controllers = script:WaitForChild("Controllers")

local ORDER = { "HUD", "GarageUI", "DriveController", "Sirens" }

local loaded = {}
for _, name in ORDER do
	table.insert(loaded, require(Controllers:WaitForChild(name) :: ModuleScript) :: any)
end
for _, c in loaded do
	if typeof(c.init) == "function" then
		c.init()
	end
end
for _, c in loaded do
	if typeof(c.start) == "function" then
		task.spawn(c.start)
	end
end
]]></ProtectedString></Properties><Item class="Folder" referent="RBX26"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">DriveController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Drives the local player's car. When you sit in your own driver seat, the
-- server hands you network ownership and this controller runs CarPhysics
-- every frame using the VehicleSeat's throttle/steer (keyboard, gamepad and
-- mobile thumbstick all feed those), plus extra driving actions.

local ContextActionService = game:GetService("ContextActionService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarPhysics = require(Shared.CarPhysics)
local Remotes = require(Shared.Remotes)

local HUD = require(script.Parent.HUD)

local DriveController = {}

local player = Players.LocalPlayer
local active: { disconnect: () -> () }? = nil

local input = { throttle = 0, steer = 0, handbrake = false, nitro = false }

local function keyAxis(pos: { Enum.KeyCode }, neg: { Enum.KeyCode }): number
	local v = 0
	for _, k in pos do
		if UserInputService:IsKeyDown(k) then
			v += 1
			break
		end
	end
	for _, k in neg do
		if UserInputService:IsKeyDown(k) then
			v -= 1
			break
		end
	end
	return v
end

local function stopDriving()
	if active then
		active.disconnect()
		active = nil
	end
end

local function startDriving(car: Model, seat: VehicleSeat)
	stopDriving()
	local statsJson = car:GetAttribute("Stats") :: string?
	if not statsJson then
		return
	end
	local physics = CarPhysics.new(car, HttpService:JSONDecode(statsJson), true)
	local connections: { RBXScriptConnection } = {}
	local actions = { "MM_Handbrake", "MM_Nitro", "MM_Exit", "MM_ShiftUp", "MM_ShiftDown", "MM_Manual", "MM_Reset" }

	local function syncAttrs()
		physics.fuelEmpty = ((car:GetAttribute("Fuel") :: number?) or 1) <= 0
		physics.tiresPopped = car:GetAttribute("TiresPopped") == true
	end
	syncAttrs()
	table.insert(connections, car.AttributeChanged:Connect(function(name)
		if name == "Stats" then
			local json = car:GetAttribute("Stats") :: string?
			if json then
				physics:setStats(HttpService:JSONDecode(json))
			end
		elseif name == "Fuel" or name == "TiresPopped" then
			local wasEmpty = physics.fuelEmpty
			syncAttrs()
			if physics.fuelEmpty and not wasEmpty then
				HUD.notify("Out of fuel! Push to a gas station... or call your car from the garage.", "warn")
			end
		end
	end))

	local function handle(name: string, state: Enum.UserInputState): Enum.ContextActionResult
		local down = state == Enum.UserInputState.Begin
		if name == "MM_Handbrake" then
			input.handbrake = state ~= Enum.UserInputState.End and state ~= Enum.UserInputState.Cancel
		elseif name == "MM_Nitro" then
			input.nitro = state ~= Enum.UserInputState.End and state ~= Enum.UserInputState.Cancel
		elseif down and name == "MM_Exit" then
			Remotes.event("ExitCar"):FireServer()
		elseif down and name == "MM_ShiftUp" and physics.manual then
			physics:shift(1)
		elseif down and name == "MM_ShiftDown" and physics.manual then
			physics:shift(-1)
		elseif down and name == "MM_Manual" then
			physics.manual = not physics.manual
			HUD.notify(if physics.manual then "Manual gearbox (E/Q to shift)" else "Automatic gearbox", "info")
		elseif down and name == "MM_Reset" then
			if physics.chassis.AssemblyLinearVelocity.Magnitude < 15 then
				physics:reset()
			end
		end
		return Enum.ContextActionResult.Sink
	end

	local prio = Enum.ContextActionPriority.High.Value + 10
	-- Space is sunk here so it acts as handbrake instead of jumping out of the seat
	ContextActionService:BindActionAtPriority("MM_Handbrake", handle, true, prio, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	ContextActionService:BindActionAtPriority("MM_Nitro", handle, true, prio, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonX)
	ContextActionService:BindActionAtPriority("MM_Exit", handle, true, prio, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
	ContextActionService:BindActionAtPriority("MM_ShiftUp", handle, false, prio, Enum.KeyCode.E, Enum.KeyCode.ButtonR1)
	ContextActionService:BindActionAtPriority("MM_ShiftDown", handle, false, prio, Enum.KeyCode.Q, Enum.KeyCode.ButtonL1)
	ContextActionService:BindActionAtPriority("MM_Manual", handle, false, prio, Enum.KeyCode.M)
	ContextActionService:BindActionAtPriority("MM_Reset", handle, false, prio, Enum.KeyCode.R)
	for name, title in { MM_Handbrake = "Brake", MM_Nitro = "NOS", MM_Exit = "Exit" } do
		local btn = ContextActionService:GetButton(name)
		if btn then
			ContextActionService:SetTitle(name, title)
		end
	end
	if ContextActionService:GetButton("MM_Nitro") then
		ContextActionService:SetPosition("MM_Nitro", UDim2.new(1, -200, 1, -150))
		ContextActionService:SetPosition("MM_Handbrake", UDim2.new(1, -130, 1, -210))
		ContextActionService:SetPosition("MM_Exit", UDim2.new(1, -80, 0, 60))
	end

	table.insert(connections, RunService.Stepped:Connect(function(_, dt)
		if not car.Parent then
			stopDriving()
			return
		end
		local kThrottle = keyAxis({ Enum.KeyCode.W, Enum.KeyCode.Up }, { Enum.KeyCode.S, Enum.KeyCode.Down })
		local kSteer = keyAxis({ Enum.KeyCode.D, Enum.KeyCode.Right }, { Enum.KeyCode.A, Enum.KeyCode.Left })
		input.throttle = if kThrottle ~= 0 then kThrottle else seat.ThrottleFloat
		input.steer = if kSteer ~= 0 then kSteer else seat.SteerFloat
		local telemetry = physics:step(dt, input)
		HUD.setTelemetry(telemetry, physics.manual, (car:GetAttribute("Fuel") :: number? or 0) / (car:GetAttribute("FuelCapacity") :: number? or 1), physics.tiresPopped)
	end))

	active = {
		disconnect = function()
			for _, c in connections do
				c:Disconnect()
			end
			for _, a in actions do
				ContextActionService:UnbindAction(a)
			end
			input.handbrake = false
			input.nitro = false
			HUD.setTelemetry(nil, false, 0, false)
		end,
	}
end

local function onCharacter(char: Model)
	stopDriving()
	local hum = char:WaitForChild("Humanoid") :: Humanoid
	hum.Seated:Connect(function(isSeated: boolean, seatPart: BasePart?)
		if isSeated and seatPart and seatPart:IsA("VehicleSeat") and seatPart.Name == "DriverSeat" then
			local car = seatPart.Parent
			if car and car:IsA("Model") and car:GetAttribute("Owner") == player.UserId then
				startDriving(car, seatPart)
			end
		else
			stopDriving()
		end
	end)
	hum.Died:Connect(stopDriving)
end

function DriveController.init() end

function DriveController.start()
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)
end

return DriveController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">GarageUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- Garage screen (opened from a garage terminal): buy/switch cars, install
-- performance upgrades, paint & body kits, and free tuning sliders. All
-- purchases are requests; the server validates price, ownership and location.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local CarStats = require(Shared.CarStats)
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)

local GarageUI = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local root: Frame
local content: ScrollingFrame
local statsPanel: Frame
local tab = "Dealership"
local profile: any = nil

local TABS = { "Dealership", "Performance", "Visual", "Tuning" }

local function clear(frame: Instance)
	for _, c in frame:GetChildren() do
		if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
end

local function row(height: number): Frame
	local f = UI.frame(content, UDim2.new(1, -12, 0, height), UDim2.new(), UI.Colors.Panel)
	UI.corner(f)
	return f
end

local function selectedData(): (string?, any)
	if not profile then
		return nil, nil
	end
	return profile.Selected, profile.Cars[profile.Selected]
end

----------------------------------------------------------------------
-- Tabs
----------------------------------------------------------------------
local function renderDealership()
	for _, carId in Config.CarOrder do
		local def = Config.Cars[carId]
		local stats = CarStats.compute(carId, nil)
		local owned = profile.Cars[carId] ~= nil
		local f = row(76)
		local name = UI.label(f, def.Name, UDim2.new(0.6, 0, 0, 26), UDim2.fromOffset(12, 6), 20, UI.Colors.Text, Enum.Font.GothamBlack)
		name.TextXAlignment = Enum.TextXAlignment.Left
		local info = UI.label(
			f,
			string.format("Class %s (%d)  •  %s  •  %d mph  •  %s lbs", stats.Class, stats.Rating, def.Drivetrain, math.floor(stats.TopSpeedMph), tostring(def.Weight)),
			UDim2.new(0.65, 0, 0, 20),
			UDim2.fromOffset(12, 34),
			13,
			UI.Colors.Dim
		)
		info.TextXAlignment = Enum.TextXAlignment.Left
		if profile.Selected == carId then
			UI.label(f, "DRIVING", UDim2.fromOffset(120, 40), UDim2.new(1, -132, 0, 18), 16, UI.Colors.Good, Enum.Font.GothamBlack)
		elseif owned then
			UI.button(f, "Select & Spawn", UDim2.fromOffset(130, 40), UDim2.new(1, -142, 0, 18), UI.Colors.Accent, function()
				Remotes.event("SelectCar"):FireServer(carId)
			end)
		else
			local afford = profile.Cash >= def.Price
			UI.button(f, "Buy " .. UI.money(def.Price), UDim2.fromOffset(130, 40), UDim2.new(1, -142, 0, 18), if afford then UI.Colors.Good else Color3.fromRGB(80, 80, 90), function()
				Remotes.event("BuyCar"):FireServer(carId)
			end)
		end
	end
end

local function renderPerformance()
	local _, data = selectedData()
	if not data then
		return
	end
	for _, cat in Config.UpgradeOrder do
		local def = Config.Upgrades[cat]
		local tier = data.Upgrades[cat] or 1
		local f = row(84)
		local title = UI.label(f, def.Name .. "  —  " .. def.Tiers[tier].Name, UDim2.new(0.6, 0, 0, 24), UDim2.fromOffset(12, 6), 18, UI.Colors.Text, Enum.Font.GothamBlack)
		title.TextXAlignment = Enum.TextXAlignment.Left
		local desc = UI.label(f, def.Desc, UDim2.new(0.62, 0, 0, 30), UDim2.fromOffset(12, 30), 12, UI.Colors.Dim)
		desc.TextXAlignment = Enum.TextXAlignment.Left
		desc.TextYAlignment = Enum.TextYAlignment.Top
		-- tier pips (click a lower one to downgrade for free)
		for i = 1, #def.Tiers do
			local pip = UI.button(f, "", UDim2.fromOffset(26, 10), UDim2.fromOffset(12 + (i - 1) * 30, 64), if i <= tier then UI.Colors.Accent else Color3.fromRGB(60, 60, 70), function()
				if i < tier then
					Remotes.event("BuyUpgrade"):FireServer(cat, i)
				end
			end)
			pip.AutoButtonColor = i < tier
		end
		if tier < #def.Tiers then
			local nextTier = def.Tiers[tier + 1]
			local afford = profile.Cash >= nextTier.Price
			UI.button(f, string.format("%s\n%s", nextTier.Name, UI.money(nextTier.Price)), UDim2.fromOffset(130, 52), UDim2.new(1, -142, 0, 16), if afford then UI.Colors.Good else Color3.fromRGB(80, 80, 90), function()
				Remotes.event("BuyUpgrade"):FireServer(cat, tier + 1)
			end)
		else
			UI.label(f, "MAXED", UDim2.fromOffset(130, 52), UDim2.new(1, -142, 0, 16), 18, UI.Colors.Pink, Enum.Font.GothamBlack)
		end
	end
end

local function renderVisual()
	local _, data = selectedData()
	if not data then
		return
	end
	local function optionRow(key: string, title: string, options: { { name: string, color: Color3? } })
		local price = Config.CosmeticPrices[key]
		local f = row(96)
		local t = UI.label(f, string.format("%s  (%s each)", title, UI.money(price)), UDim2.new(1, -24, 0, 22), UDim2.fromOffset(12, 6), 16, UI.Colors.Text, Enum.Font.GothamBlack)
		t.TextXAlignment = Enum.TextXAlignment.Left
		local holder = Instance.new("ScrollingFrame")
		holder.Size = UDim2.new(1, -24, 0, 60)
		holder.Position = UDim2.fromOffset(12, 30)
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.ScrollBarThickness = 4
		holder.ScrollingDirection = Enum.ScrollingDirection.X
		holder.AutomaticCanvasSize = Enum.AutomaticSize.X
		holder.CanvasSize = UDim2.new()
		holder.Parent = f
		local layout = Instance.new("UIListLayout")
		layout.FillDirection = Enum.FillDirection.Horizontal
		layout.Padding = UDim.new(0, 6)
		layout.Parent = holder
		for _, opt in options do
			local current = data.Cosmetics[key] == opt.name
			local b = UI.button(holder, if opt.color then "" else opt.name, UDim2.fromOffset(if opt.color then 48 else 96, 48), UDim2.new(), opt.color or Color3.fromRGB(50, 50, 62), function()
				Remotes.event("SetCosmetic"):FireServer(key, opt.name)
			end)
			if opt.color then
				b.Text = if current then "✔" else ""
				b.TextStrokeTransparency = 0
			end
			if current then
				local s = Instance.new("UIStroke")
				s.Color = UI.Colors.Pink
				s.Thickness = 3
				s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				s.Parent = b
			end
		end
	end
	local function named(list: { any }, withColor: boolean): { { name: string, color: Color3? } }
		local out = {}
		for _, o in list do
			table.insert(out, { name = o.Name, color = if withColor then o.Color else nil })
		end
		return out
	end
	optionRow("Paint", "Paint", named(Config.Paints, true))
	optionRow("Finish", "Finish", named(Config.Finishes, false))
	optionRow("Rims", "Rim Color", named(Config.RimColors, true))
	local glows = {}
	for _, g in Config.Underglows do
		table.insert(glows, { name = g.Name, color = g.Color })
	end
	optionRow("Underglow", "Underglow (Off = grey)", glows)
	local spoilers = {}
	for _, s in Config.Spoilers do
		table.insert(spoilers, { name = s })
	end
	optionRow("Spoiler", "Spoiler / Body Kit", spoilers)
	optionRow("Tint", "Window Tint", named(Config.Tints, false))
end

local function renderTuning()
	local _, data = selectedData()
	if not data then
		return
	end
	for _, key in Config.TuningOrder do
		local spec = Config.Tuning[key]
		local value = data.Tuning[key] or spec.Default
		local f = row(60)
		local t = UI.label(f, spec.Label, UDim2.new(0.5, 0, 1, 0), UDim2.fromOffset(12, 0), 16, UI.Colors.Text, Enum.Font.GothamBlack)
		t.TextXAlignment = Enum.TextXAlignment.Left
		UI.button(f, "−", UDim2.fromOffset(40, 40), UDim2.new(1, -190, 0, 10), Color3.fromRGB(60, 60, 75), function()
			Remotes.event("SetTuning"):FireServer(key, value - spec.Step)
		end)
		UI.label(f, string.format("%.2f", value), UDim2.fromOffset(90, 40), UDim2.new(1, -146, 0, 10), 18, UI.Colors.Accent, Enum.Font.GothamBlack)
		UI.button(f, "+", UDim2.fromOffset(40, 40), UDim2.new(1, -52, 0, 10), Color3.fromRGB(60, 60, 75), function()
			Remotes.event("SetTuning"):FireServer(key, value + spec.Step)
		end)
	end
	local note = row(46)
	UI.label(note, "Tuning is free. Lower + stiffer = more grip on smooth tarmac. Gearing + = quicker launch, lower top speed.", UDim2.new(1, -24, 1, 0), UDim2.fromOffset(12, 0), 12, UI.Colors.Dim)
end

local function renderStats()
	clear(statsPanel)
	local carId, data = selectedData()
	if not carId or not data then
		return
	end
	local s = CarStats.compute(carId, data)
	local lines = {
		string.format("%s", Config.Cars[carId].Name),
		string.format("CLASS %s  •  PI %d", s.Class, s.Rating),
		"",
		string.format("Top speed      %d mph", math.floor(s.TopSpeedMph)),
		string.format("Power          %.1f", s.Power * s.WeightFactor),
		string.format("Redline        %d rpm", s.Redline),
		string.format("Shift time     %.2f s", s.ShiftTime),
		string.format("Grip           %.2f g", s.Grip),
		string.format("Brakes         %.0f", s.Brake),
		string.format("Springs        %.2f Hz", s.SpringFreq),
		string.format("Ride height    %.2f", s.RideHeight),
		string.format("Nitrous        %ds  x%.2f", s.NitroCapacity, s.NitroBoost),
		string.format("Fuel tank      %.1f gal", s.FuelCapacity),
		string.format("Drivetrain     %s", s.Drivetrain),
		"",
		string.format("Best 1/4 mile  %s", if profile.Best.Quarter then string.format("%.3fs", profile.Best.Quarter) else "--"),
		string.format("Best 1/2 mile  %s", if profile.Best.Half then string.format("%.3fs", profile.Best.Half) else "--"),
		string.format("Races %d  Wins %d", profile.Stats.Races or 0, profile.Stats.Wins or 0),
		string.format("Escapes %d  Busts %d", profile.Stats.Escapes or 0, profile.Stats.Busts or 0),
	}
	local l = UI.label(statsPanel, table.concat(lines, "\n"), UDim2.new(1, -20, 1, -20), UDim2.fromOffset(10, 10), 14, UI.Colors.Text, Enum.Font.Code)
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
end

local function render()
	if not root or not root.Visible or not profile then
		return
	end
	clear(content)
	if tab == "Dealership" then
		renderDealership()
	elseif tab == "Performance" then
		renderPerformance()
	elseif tab == "Visual" then
		renderVisual()
	elseif tab == "Tuning" then
		renderTuning()
	end
	renderStats()
	local cashLabel = root:FindFirstChild("Cash") :: TextLabel?
	if cashLabel then
		cashLabel.Text = UI.money(profile.Cash)
	end
	for _, b in (root:FindFirstChild("Tabs") :: Frame):GetChildren() do
		if b:IsA("TextButton") then
			b.BackgroundColor3 = if b.Name == tab then UI.Colors.Pink else Color3.fromRGB(50, 50, 62)
		end
	end
end

function GarageUI.open()
	root.Visible = true
	render()
end

function GarageUI.close()
	root.Visible = false
end

function GarageUI.init()
	gui = Instance.new("ScreenGui")
	gui.Name = "Garage"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	gui.Parent = player:WaitForChild("PlayerGui")

	root = UI.frame(gui, UDim2.new(0.86, 0, 0.84, 0), UDim2.new(0.07, 0, 0.08, 0), UI.Colors.Bg, 0.05)
	UI.corner(root, 12)
	root.Visible = false
	local size = Instance.new("UISizeConstraint")
	size.MaxSize = Vector2.new(1100, 720)
	size.Parent = root

	local title = UI.label(root, "MIDNIGHT MOTORS GARAGE", UDim2.new(0.6, 0, 0, 40), UDim2.fromOffset(18, 8), 26, UI.Colors.Accent, Enum.Font.GothamBlack)
	title.TextXAlignment = Enum.TextXAlignment.Left
	local cash = UI.label(root, "$0", UDim2.fromOffset(200, 40), UDim2.new(1, -270, 0, 8), 24, UI.Colors.Good, Enum.Font.GothamBlack)
	cash.Name = "Cash"
	cash.TextXAlignment = Enum.TextXAlignment.Right
	UI.button(root, "X", UDim2.fromOffset(40, 40), UDim2.new(1, -54, 0, 8), UI.Colors.Bad, GarageUI.close)

	local tabs = UI.frame(root, UDim2.new(1, -36, 0, 40), UDim2.fromOffset(18, 56), nil, 1)
	tabs.Name = "Tabs"
	local tl = Instance.new("UIListLayout")
	tl.FillDirection = Enum.FillDirection.Horizontal
	tl.Padding = UDim.new(0, 8)
	tl.Parent = tabs
	for _, name in TABS do
		local b = UI.button(tabs, name, UDim2.fromOffset(140, 38), UDim2.new(), Color3.fromRGB(50, 50, 62), function()
			tab = name
			render()
		end)
		b.Name = name
	end

	content = Instance.new("ScrollingFrame")
	content.Size = UDim2.new(0.66, -24, 1, -116)
	content.Position = UDim2.fromOffset(18, 104)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ScrollBarThickness = 6
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.CanvasSize = UDim2.new()
	content.Parent = root
	local cl = Instance.new("UIListLayout")
	cl.Padding = UDim.new(0, 8)
	cl.Parent = content

	statsPanel = UI.frame(root, UDim2.new(0.34, -18, 1, -116), UDim2.new(0.66, 0, 0, 104), UI.Colors.Panel)
	UI.corner(statsPanel)
end

function GarageUI.start()
	Remotes.event("OpenGarage").OnClientEvent:Connect(GarageUI.open)
	Remotes.event("ProfileUpdated").OnClientEvent:Connect(function(p)
		profile = p
		render()
	end)
	task.spawn(function()
		profile = Remotes.func("GetProfile"):InvokeServer()
		render()
	end)
	-- close automatically when you walk/drive away from the terminal
	task.spawn(function()
		local openedAt: Vector3? = nil
		while true do
			task.wait(0.5)
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root.Visible and hrp then
				openedAt = openedAt or hrp.Position
				if (hrp.Position - (openedAt :: Vector3)).Magnitude > 60 then
					GarageUI.close()
				end
			else
				openedAt = nil
			end
		end
	end)
end

return GarageUI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--!strict
-- Heads-up display: speedometer/tach/gear/nitro/fuel, cash, speed limit sign,
-- wanted stars with bust/escape meters, car meet indicator, drag-race tree and
-- results, notifications and the speed-camera flash.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)

local HUD = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local refs: { [string]: any } = {}
local toastHolder: Frame

----------------------------------------------------------------------
-- Notifications
----------------------------------------------------------------------
local KIND_COLORS = {
	info = UI.Colors.Accent,
	money = UI.Colors.Good,
	warn = UI.Colors.Warn,
	police = Color3.fromRGB(70, 110, 255),
	bust = UI.Colors.Bad,
}

function HUD.notify(text: string, kind: string?)
	if not toastHolder then
		return
	end
	local color = KIND_COLORS[kind or "info"] or UI.Colors.Accent
	local f = UI.frame(toastHolder, UDim2.new(1, 0, 0, 34), UDim2.new(), UI.Colors.Bg, 0.15)
	UI.corner(f, 6)
	local stripe = UI.frame(f, UDim2.new(0, 5, 1, 0), UDim2.new(), color)
	UI.corner(stripe, 3)
	local l = UI.label(f, text, UDim2.new(1, -16, 1, 0), UDim2.fromOffset(12, 0), 15, UI.Colors.Text)
	l.TextXAlignment = Enum.TextXAlignment.Left
	task.delay(if kind == "bust" then 7 else 4.5, function()
		local tween = TweenService:Create(f, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		TweenService:Create(stripe, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		tween:Play()
		tween.Completed:Wait()
		f:Destroy()
	end)
end

----------------------------------------------------------------------
-- Speedometer
----------------------------------------------------------------------
function HUD.setTelemetry(t: any?, manual: boolean, fuel: number, popped: boolean)
	local speedo = refs.speedo :: Frame
	if not speedo then
		return
	end
	speedo.Visible = t ~= nil
	if not t then
		return
	end
	refs.mph.Text = tostring(math.floor(t.mph))
	refs.gear.Text = t.gear
	local rpmFrac = math.clamp(t.rpm / t.redline, 0, 1)
	refs.rpmFill.Size = UDim2.fromScale(rpmFrac, 1)
	refs.rpmFill.BackgroundColor3 = if rpmFrac > 0.92 then UI.Colors.Bad elseif rpmFrac > 0.75 then UI.Colors.Warn else UI.Colors.Accent
	refs.rpmText.Text = string.format("%d RPM", math.floor(t.rpm / 10) * 10)
	refs.nitroFill.Size = UDim2.fromScale(math.clamp(t.nitro, 0, 1), 1)
	refs.fuelFill.Size = UDim2.fromScale(math.clamp(fuel, 0, 1), 1)
	refs.fuelFill.BackgroundColor3 = if fuel < 0.15 then UI.Colors.Bad else UI.Colors.Warn
	local tags = {}
	table.insert(tags, if manual then "MANUAL" else "AUTO")
	if t.drifting then
		table.insert(tags, "DRIFT!")
	end
	if popped then
		table.insert(tags, "TIRES POPPED")
	end
	refs.mode.Text = table.concat(tags, "  ")
end

----------------------------------------------------------------------
-- Drag racing overlay
----------------------------------------------------------------------
local function showRace(payload: { [string]: any })
	local big = refs.raceBig :: TextLabel
	if payload.type == "Staged" then
		big.Text = "STAGED"
		big.TextColor3 = UI.Colors.Text
		big.Visible = true
	elseif payload.type == "Tree" then
		big.Visible = true
		if payload.step < 4 then
			big.Text = string.rep("● ", payload.step)
			big.TextColor3 = UI.Colors.Warn
		else
			big.Text = "GO!"
			big.TextColor3 = UI.Colors.Good
			task.delay(1.2, function()
				if big.Text == "GO!" then
					big.Visible = false
				end
			end)
		end
	elseif payload.type == "Result" then
		big.Visible = false
		local panel = refs.racePanel :: Frame
		local text: string
		if payload.result == "Finished" then
			text = string.format(
				"%s MILE\nET  %.3f s\nTRAP  %d MPH\nR/T  %s%s%s\n+%s",
				string.upper(payload.strip),
				payload.et,
				math.floor(payload.trap),
				if payload.reaction then string.format("%.3f", payload.reaction) else "--",
				if payload.racers > 1 then (if payload.place == 1 then "\nWINNER!" else "\nYou lost") else "",
				if payload.pb then "\nNEW PERSONAL BEST" else "",
				UI.money(payload.payout)
			)
		else
			text = string.format("%s MILE\n%s", string.upper(payload.strip), string.upper(payload.result))
		end
		refs.raceText.Text = text
		panel.Visible = true
		task.delay(7, function()
			panel.Visible = false
		end)
	end
end

----------------------------------------------------------------------
-- Police / zone / meet attributes
----------------------------------------------------------------------
local function refreshPolice()
	local heat = (player:GetAttribute("Heat") :: number?) or 0
	local status = (player:GetAttribute("PoliceStatus") :: string?) or ""
	local wanted = refs.wanted :: Frame
	wanted.Visible = heat > 0
	for i, star in refs.stars do
		star.TextColor3 = if i <= heat then UI.Colors.Warn else Color3.fromRGB(70, 70, 80)
	end
	if status == "PullOver" then
		refs.policeText.Text = string.format("PULL OVER!  %ds", math.ceil((player:GetAttribute("PullOverTime") :: number?) or 0))
	elseif status == "Pursuit" then
		refs.policeText.Text = "EVADING POLICE"
	else
		refs.policeText.Text = ""
	end
	refs.bustFill.Size = UDim2.fromScale((player:GetAttribute("BustProgress") :: number?) or 0, 1)
	refs.escapeFill.Size = UDim2.fromScale((player:GetAttribute("EscapeProgress") :: number?) or 0, 1)
end

local function refreshZone()
	local limit = (player:GetAttribute("SpeedLimit") :: number?) or 0
	local zone = (player:GetAttribute("Zone") :: string?) or ""
	refs.limitNum.Text = if limit > 0 then tostring(limit) else "--"
	refs.zone.Text = string.upper(zone)
	local meet = (player:GetAttribute("Meet") :: string?) or ""
	refs.meet.Visible = meet ~= ""
	refs.meet.Text = string.format("CAR MEET: %s  •  %d car(s) parked", meet, (player:GetAttribute("MeetCount") :: number?) or 0)
end

----------------------------------------------------------------------
-- Build
----------------------------------------------------------------------
function HUD.init()
	gui = Instance.new("ScreenGui")
	gui.Name = "MidnightHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.Parent = player:WaitForChild("PlayerGui")

	-- cash + speed limit (top left)
	local cash = UI.label(gui, "$0", UDim2.fromOffset(240, 36), UDim2.fromOffset(16, 10), 28, UI.Colors.Good, Enum.Font.GothamBlack)
	cash.TextXAlignment = Enum.TextXAlignment.Left
	refs.cash = cash
	local sign = UI.frame(gui, UDim2.fromOffset(70, 86), UDim2.fromOffset(16, 52), Color3.fromRGB(245, 245, 245))
	UI.corner(sign, 6)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(20, 20, 20)
	stroke.Parent = sign
	UI.label(sign, "SPEED\nLIMIT", UDim2.new(1, 0, 0, 30), UDim2.fromOffset(0, 4), 11, Color3.fromRGB(20, 20, 20), Enum.Font.GothamBlack)
	refs.limitNum = UI.label(sign, "--", UDim2.new(1, 0, 0, 40), UDim2.fromOffset(0, 36), 32, Color3.fromRGB(20, 20, 20), Enum.Font.GothamBlack)
	refs.zone = UI.label(gui, "", UDim2.fromOffset(160, 20), UDim2.fromOffset(92, 52), 14, UI.Colors.Dim)
	refs.zone.TextXAlignment = Enum.TextXAlignment.Left

	-- wanted (top right)
	local wanted = UI.frame(gui, UDim2.fromOffset(250, 104), UDim2.new(1, -266, 0, 10), UI.Colors.Bg, 0.25)
	UI.corner(wanted)
	wanted.Visible = false
	refs.wanted = wanted
	refs.stars = {}
	for i = 1, 5 do
		local s = UI.label(wanted, "★", UDim2.fromOffset(40, 36), UDim2.fromOffset(10 + (i - 1) * 46, 4), 34, UI.Colors.Warn, Enum.Font.GothamBlack)
		refs.stars[i] = s
	end
	refs.policeText = UI.label(wanted, "", UDim2.new(1, -20, 0, 20), UDim2.fromOffset(10, 42), 15, Color3.fromRGB(120, 160, 255), Enum.Font.GothamBlack)
	UI.label(wanted, "BUST", UDim2.fromOffset(50, 14), UDim2.fromOffset(10, 66), 11, UI.Colors.Bad)
	local _, bustFill = UI.bar(wanted, UDim2.new(1, -76, 0, 8), UDim2.fromOffset(64, 69), UI.Colors.Bad)
	refs.bustFill = bustFill
	UI.label(wanted, "ESCAPE", UDim2.fromOffset(50, 14), UDim2.fromOffset(10, 84), 11, UI.Colors.Good)
	local _, escapeFill = UI.bar(wanted, UDim2.new(1, -76, 0, 8), UDim2.fromOffset(64, 87), UI.Colors.Good)
	refs.escapeFill = escapeFill

	-- notifications (top centre)
	toastHolder = UI.frame(gui, UDim2.fromOffset(420, 300), UDim2.new(0.5, -210, 0, 10), nil, 1)
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 6)
	list.Parent = toastHolder

	-- meet indicator
	local meet = UI.label(gui, "", UDim2.fromOffset(420, 30), UDim2.new(0.5, -210, 1, -150), 18, UI.Colors.Pink, Enum.Font.GothamBlack)
	meet.Visible = false
	refs.meet = meet

	-- speedometer (bottom right)
	local speedo = UI.frame(gui, UDim2.fromOffset(260, 150), UDim2.new(1, -276, 1, -166), UI.Colors.Bg, 0.2)
	UI.corner(speedo, 10)
	speedo.Visible = false
	refs.speedo = speedo
	refs.mph = UI.label(speedo, "0", UDim2.fromOffset(150, 64), UDim2.fromOffset(10, 4), 60, UI.Colors.Text, Enum.Font.GothamBlack)
	refs.mph.TextXAlignment = Enum.TextXAlignment.Right
	UI.label(speedo, "MPH", UDim2.fromOffset(40, 20), UDim2.fromOffset(162, 42), 14, UI.Colors.Dim)
	refs.gear = UI.label(speedo, "N", UDim2.fromOffset(50, 56), UDim2.fromOffset(204, 8), 44, UI.Colors.Accent, Enum.Font.GothamBlack)
	local _, rpmFill = UI.bar(speedo, UDim2.new(1, -20, 0, 12), UDim2.fromOffset(10, 74), UI.Colors.Accent)
	refs.rpmFill = rpmFill
	refs.rpmText = UI.label(speedo, "", UDim2.fromOffset(120, 14), UDim2.fromOffset(10, 88), 11, UI.Colors.Dim)
	refs.rpmText.TextXAlignment = Enum.TextXAlignment.Left
	UI.label(speedo, "NOS", UDim2.fromOffset(34, 14), UDim2.fromOffset(10, 106), 11, Color3.fromRGB(80, 160, 255))
	local _, nitroFill = UI.bar(speedo, UDim2.new(1, -60, 0, 8), UDim2.fromOffset(48, 109), Color3.fromRGB(80, 160, 255))
	refs.nitroFill = nitroFill
	UI.label(speedo, "FUEL", UDim2.fromOffset(34, 14), UDim2.fromOffset(10, 122), 11, UI.Colors.Warn)
	local _, fuelFill = UI.bar(speedo, UDim2.new(1, -60, 0, 8), UDim2.fromOffset(48, 125), UI.Colors.Warn)
	refs.fuelFill = fuelFill
	refs.mode = UI.label(speedo, "", UDim2.fromOffset(150, 14), UDim2.fromOffset(100, 88), 11, UI.Colors.Pink)
	refs.mode.TextXAlignment = Enum.TextXAlignment.Right

	-- buttons (bottom left)
	UI.button(gui, "Call My Car", UDim2.fromOffset(130, 38), UDim2.new(0, 16, 1, -100), UI.Colors.Accent, function()
		Remotes.event("SpawnCar"):FireServer()
	end)
	local help = UI.label(
		gui,
		"W/S throttle & brake • A/D steer • Space handbrake • Shift nitro\nF exit car • M manual • E/Q shift • R flip • E near car to drive",
		UDim2.fromOffset(460, 36),
		UDim2.new(0, 16, 1, -54),
		12,
		UI.Colors.Dim
	)
	help.TextXAlignment = Enum.TextXAlignment.Left

	-- race overlay
	local big = UI.label(gui, "", UDim2.fromOffset(500, 90), UDim2.new(0.5, -250, 0.3, 0), 72, UI.Colors.Warn, Enum.Font.GothamBlack)
	big.Visible = false
	refs.raceBig = big
	local panel = UI.frame(gui, UDim2.fromOffset(280, 190), UDim2.new(0.5, -140, 0.25, 0), UI.Colors.Bg, 0.1)
	UI.corner(panel, 10)
	panel.Visible = false
	refs.racePanel = panel
	refs.raceText = UI.label(panel, "", UDim2.new(1, -20, 1, -20), UDim2.fromOffset(10, 10), 20, UI.Colors.Text, Enum.Font.GothamBlack)

	-- camera flash
	local flash = UI.frame(gui, UDim2.fromScale(1, 1), UDim2.new(), Color3.new(1, 1, 1), 1)
	flash.ZIndex = 50
	refs.flash = flash
end

function HUD.flash()
	local flash = refs.flash :: Frame
	flash.BackgroundTransparency = 0.1
	TweenService:Create(flash, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
end

function HUD.start()
	Remotes.event("Notify").OnClientEvent:Connect(function(text: string, kind: string?)
		HUD.notify(text, kind)
	end)
	Remotes.event("RaceUpdate").OnClientEvent:Connect(showRace)
	Remotes.event("CameraFlash").OnClientEvent:Connect(HUD.flash)
	Remotes.event("ProfileUpdated").OnClientEvent:Connect(function(profile)
		refs.cash.Text = UI.money(profile.Cash)
	end)
	for _, attr in { "Heat", "PoliceStatus", "BustProgress", "EscapeProgress", "PullOverTime" } do
		player:GetAttributeChangedSignal(attr):Connect(refreshPolice)
	end
	for _, attr in { "Zone", "SpeedLimit", "Meet", "MeetCount" } do
		player:GetAttributeChangedSignal(attr):Connect(refreshZone)
	end
	refreshPolice()
	refreshZone()
	task.spawn(function()
		local profile = Remotes.func("GetProfile"):InvokeServer()
		if profile then
			refs.cash.Text = UI.money(profile.Cash)
		end
	end)
end

return HUD
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">Sirens</string><ProtectedString name="Source"><![CDATA[--!strict
-- Flashes police lightbars locally (no network cost) for any police vehicle
-- or helicopter whose model has the "Sirens" attribute set.

local CollectionService = game:GetService("CollectionService")

local Sirens = {}

local OFF = Color3.fromRGB(30, 30, 30)

function Sirens.init() end

function Sirens.start()
	local tick = 0
	while true do
		task.wait(0.12)
		tick += 1
		for _, part in CollectionService:GetTagged("Lightbar") do
			if not part:IsA("BasePart") then
				continue
			end
			local model = part:FindFirstAncestorOfClass("Model")
			local on = model ~= nil and model:GetAttribute("Sirens") == true
			local color = part:GetAttribute("LightColor") :: Color3?
			local isRed = color ~= nil and color.R > color.B
			local lit = on and ((tick % 2 == 0) == isRed)
			part.Color = if lit and color then color else OFF
			local light = part:FindFirstChildOfClass("PointLight")
			if light then
				light.Enabled = lit
			end
		end
	end
end

return Sirens
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--!strict
-- Tiny UI helpers shared by the HUD and garage screens.

local UI = {}

UI.Colors = {
	Bg = Color3.fromRGB(14, 14, 20),
	Panel = Color3.fromRGB(24, 24, 34),
	Accent = Color3.fromRGB(0, 190, 255),
	Pink = Color3.fromRGB(255, 60, 200),
	Text = Color3.fromRGB(240, 240, 245),
	Dim = Color3.fromRGB(150, 150, 165),
	Good = Color3.fromRGB(60, 230, 120),
	Warn = Color3.fromRGB(255, 190, 40),
	Bad = Color3.fromRGB(255, 60, 60),
}

function UI.corner(parent: Instance, radius: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
end

function UI.frame(parent: Instance, size: UDim2, pos: UDim2, color: Color3?, transparency: number?): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = color or UI.Colors.Panel
	f.BackgroundTransparency = transparency or 0
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

function UI.label(parent: Instance, text: string, size: UDim2, pos: UDim2, textSize: number?, color: Color3?, font: Enum.Font?): TextLabel
	local l = Instance.new("TextLabel")
	l.Size = size
	l.Position = pos
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = color or UI.Colors.Text
	l.Font = font or Enum.Font.GothamBold
	l.TextSize = textSize or 16
	l.TextWrapped = true
	l.Parent = parent
	return l
end

function UI.button(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3?, onClick: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = color or UI.Colors.Accent
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = UI.Colors.Text
	b.Font = Enum.Font.GothamBold
	b.TextSize = 15
	b.AutoButtonColor = true
	b.TextWrapped = true
	b.Parent = parent
	UI.corner(b, 6)
	b.Activated:Connect(onClick)
	return b
end

function UI.bar(parent: Instance, size: UDim2, pos: UDim2, color: Color3): (Frame, Frame)
	local back = UI.frame(parent, size, pos, Color3.fromRGB(40, 40, 50))
	UI.corner(back, 4)
	local fill = UI.frame(back, UDim2.fromScale(0, 1), UDim2.new(), color)
	UI.corner(fill, 4)
	return back, fill
end

function UI.money(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return "$" .. out
end

return UI
]]></ProtectedString></Properties></Item>
